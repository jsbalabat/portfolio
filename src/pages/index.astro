---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureDiffSlider from '../components/pitched/ArchitectureDiffSlider';
import TechIcon from '../components/icons/TechIcon.astro';
import { getCollection } from 'astro:content';

// Retrieve all work case studies, sorted by defined order
const caseStudies = await getCollection('work');
caseStudies.sort((a, b) => a.data.order - b.data.order);

const skills = {
  Languages: [
    { name: 'TypeScript', note: 'Strict typing', highlight: true },
    { name: 'JavaScript', note: 'ESNext / Modern', highlight: false },
    { name: 'Dart', note: 'Flutter mobile', highlight: true },
    { name: 'PostgreSQL / SQL', note: 'Relational DDL & queries', highlight: true },
  ],
  Frontend: [
    { name: 'React 19', note: 'Hooks & Server Components', highlight: true },
    { name: 'Next.js', note: 'App Router & SSR', highlight: true },
    { name: 'Astro 5', note: 'Content collections & islands', highlight: false },
    { name: 'Tailwind CSS', note: 'Tailwind 4 CSS-first', highlight: false },
  ],
  Backend: [
    { name: 'Node.js', note: 'v22 Runtime', highlight: true },
    { name: 'Cloudflare Workers', note: 'Edge compute & assets', highlight: true },
    { name: 'Firebase', note: 'Cloud Functions write-path', highlight: true },
  ],
  Databases: [
    { name: 'PostgreSQL', note: 'Row-Level Security & 3NF', highlight: true },
    { name: 'Supabase', note: 'Auth & DB instances', highlight: true },
    { name: 'Cloudflare D1', note: 'Edge SQLite', highlight: false },
    { name: 'MongoDB Atlas', note: 'Document stores', highlight: false },
  ],
  Infrastructure: [
    { name: 'Docker Compose', note: 'Container orchestration', highlight: true },
    { name: 'GitHub Actions', note: 'Automated CI pipelines', highlight: false },
    { name: 'Wrangler CLI', note: 'Workers edge deployment', highlight: false },
  ],
};

const keyOutcomes: Record<string, { badge: string; text: string }> = {
  ledgerly: {
    badge: '6 Companies • ~150 Inv/Day',
    text: 'Replaced Excel billing via idempotent Cloud Functions write-path.',
  },
  unitko: {
    badge: '3NF Schema • Postgres RLS',
    text: 'Enforced tenant isolation and eliminated cash waterfall drift.',
  },
  'tell-health': {
    badge: '25/58 Retained • 6-Day Sprint',
    text: 'Deterministic Zod schema guardrails & PII scrub over LLM triage.',
  },
};
---

<BaseLayout>
  <!-- Full-Height Editorial Cover Page (True 100vh Hero Cover with zero header offset) -->
  <section id="cover" class="min-h-[100svh] py-8 sm:py-12 lg:py-16 border-b border-border/60 flex flex-col justify-between">
    <!-- Top & Middle Content -->
    <div class="my-auto py-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
        
        <!-- Left Column: Picture, Identity, Headline, and CTAs -->
        <div class="lg:col-span-8 flex flex-col items-start">
          <div class="flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface text-xs font-mono text-text-muted shadow-2xs mb-5">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Full-stack software engineer • Sole developer</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6 sm:gap-8 mb-6 w-full">
            <!-- Portrait Image (Expanded & Prominent) -->
            <div class="relative shrink-0">
              <div class="w-36 h-36 sm:w-48 sm:h-48 md:w-56 md:h-56 lg:w-60 lg:h-60 rounded-3xl overflow-hidden border-2 border-border shadow-md bg-surface-raised relative group">
                <img
                  src="/images/profile.jpg"
                  alt="Marc - Full-Stack Engineer"
                  class="w-full h-full object-cover object-center filter grayscale contrast-105 group-hover:grayscale-0 transition-all duration-500"
                  loading="eager"
                />
              </div>
              <div class="absolute -bottom-2.5 left-1/2 -translate-x-1/2 px-3 py-0.5 rounded-full bg-surface border border-border text-accent text-xs font-mono font-bold shadow-xs whitespace-nowrap">
                Marc
              </div>
            </div>

            <!-- Main Title -->
            <div class="flex-1">
              <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-text leading-[1.1]">
                I build production systems that replace manual workflows.
              </h1>
            </div>
          </div>

          <p class="text-sm sm:text-base text-text-muted leading-relaxed mb-6 max-w-3xl tldr-dim">
            Sole engineer across three shipped products in 14 months with 650+ commits. I design systems where correctness and edge cases matter: replacing Excel billing for distribution companies, fixing schema normalization bugs, and building reliable offline-first pipelines.
          </p>

          <div class="flex flex-wrap items-center gap-3 text-sm font-medium">
            <a
              href="#work"
              class="px-5 py-2.5 rounded-xl bg-accent text-accent-text hover:opacity-90 transition-all shadow-xs flex items-center gap-2 font-medium"
            >
              <span>Explore Case Studies</span>
              <span class="text-xs">↓</span>
            </a>
            <a
              href="#architecture"
              class="px-4 py-2.5 rounded-xl border border-border hover:bg-surface-raised text-text transition-colors"
            >
              Schema Diff Playground
            </a>
            <button
              type="button"
              onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
              class="px-4 py-2.5 rounded-xl border border-border hover:bg-surface-raised text-text transition-colors cursor-pointer flex items-center gap-2"
            >
              <TechIcon name="mail" class="w-4 h-4 text-accent" />
              <span>Get in Touch</span>
            </button>
            <a
              href="https://github.com/jsbalabat"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2.5 rounded-xl border border-border/80 hover:bg-surface-raised text-text-muted hover:text-text transition-colors flex items-center gap-2"
            >
              <TechIcon name="github" class="w-4 h-4 text-accent" />
              <span>GitHub</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Key Metrics Callout (Highlights in TLDR Mode) -->
        <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3.5">
          <div class="tldr-highlight flex-1 p-5 rounded-2xl border border-border bg-surface shadow-xs transition-all duration-300">
            <span class="text-[11px] font-mono uppercase tracking-wider text-accent font-semibold block mb-1">
              Shipped Products
            </span>
            <p class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">3 Applications</p>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Sole engineer from architecture to deployment.</p>
          </div>

          <div class="tldr-highlight flex-1 p-5 rounded-2xl border border-border bg-surface shadow-xs transition-all duration-300">
            <span class="text-[11px] font-mono uppercase tracking-wider text-accent font-semibold block mb-1">
              Commercial Adoption
            </span>
            <p class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">6 Companies</p>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Cleared ~150 invoices/day replacing Excel billing.</p>
          </div>

          <div class="tldr-highlight flex-1 p-5 rounded-2xl border border-border bg-surface shadow-xs transition-all duration-300">
            <span class="text-[11px] font-mono uppercase tracking-wider text-accent font-semibold block mb-1">
              Verified Git History
            </span>
            <p class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight">650+ Commits</p>
            <p class="text-xs text-text-muted mt-1 leading-relaxed">Continuous delivery over 14 months.</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Editorial Bottom Anchor / Scroll Prompt -->
    <div class="pt-6 pb-2 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-border/40 text-xs font-mono text-text-muted">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Open to full-stack, frontend, or backend roles</span>
      </div>
      <div class="flex items-center">
        <svg viewBox="0 0 24 24" class="w-5 h-5 text-text-muted animate-bounce" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- Production Tech Stack (Key tools highlight during TLDR Mode) -->
  <section id="skills" class="py-8 sm:py-10 border-b border-border/60">
    <div class="mb-5 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <h2 class="text-xs uppercase font-mono tracking-widest text-accent font-semibold mb-1">Technical Proficiency</h2>
        <p class="text-xl sm:text-2xl font-bold tracking-tight text-text">Production Stack & Tools</p>
      </div>
      <p class="text-xs font-mono text-text-muted">
        Technologies in daily engineering and shipped products
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {Object.entries(skills).map(([category, items]) => (
        <div class="p-4 rounded-xl border border-border bg-surface shadow-xs flex flex-col">
          <h3 class="text-xs font-mono font-bold text-accent uppercase tracking-wider mb-3 pb-1.5 border-b border-border/50">
            {category}
          </h3>
          <ul class="space-y-1.5 text-sm flex-1">
            {items.map((item) => (
              <li class={`flex items-center gap-2.5 px-2 py-1.5 rounded-lg transition-all duration-200 ${item.highlight ? 'tldr-highlight' : 'tldr-dim'}`}>
                <span class="w-7 h-7 rounded-md bg-surface-raised border border-border/60 flex items-center justify-center shrink-0 text-accent shadow-2xs">
                  <TechIcon name={item.name} class="w-3.5 h-3.5" />
                </span>
                <div class="min-w-0 flex-1">
                  <span class="font-medium text-xs text-text block truncate leading-tight">{item.name}</span>
                  <span class="text-[10px] text-text-muted block truncate mt-0.5 leading-tight">{item.note}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Shipped Case Studies (Outcomes & Metrics Pop during TLDR Mode) -->
  <section id="work" class="py-8 sm:py-10 border-b border-border/60">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
      <div>
        <h2 class="text-xs uppercase font-mono tracking-widest text-accent font-semibold mb-1">Deep Dives</h2>
        <p class="text-2xl sm:text-3xl font-extrabold tracking-tight text-text">Shipped Case Studies</p>
      </div>
      <p class="text-xs font-mono text-text-muted">
        Detailed architectural write-ups covering problem, system design, and bugs fixed
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-5">
      {caseStudies.map((study, index) => {
        const isPrimary = index === 0;
        const colSpan = isPrimary ? 'md:col-span-12' : 'md:col-span-6';

        return (
          <article
            class={`${colSpan} tldr-highlight rounded-2xl border border-border bg-surface p-5 sm:p-7 flex flex-col justify-between hover:border-accent/60 transition-all duration-300 group shadow-xs`}
          >
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                <div class="flex items-center gap-2 font-mono text-xs text-text-muted">
                  <span class="px-2.5 py-0.5 rounded-full bg-surface-raised border border-border font-semibold text-text">
                    0{study.data.order}
                  </span>
                  <span>{study.data.timeline}</span>
                  <span>•</span>
                  <span>{study.data.role}</span>
                </div>
                {study.data.liveUrl && (
                  <span class="tldr-badge inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-mono text-emerald-600 dark:text-emerald-400 bg-surface-raised">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    Live in production
                  </span>
                )}
                {study.data.demoVideo && (
                  <span class="tldr-badge inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-mono text-accent bg-surface-raised">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                    Video demo available
                  </span>
                )}
              </div>

              <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-text group-hover:text-accent transition-colors mb-2">
                <a href={`/work/${study.id}`} class="focus:outline-none">
                  {study.data.title}
                </a>
              </h3>

              <p class="text-sm text-text-muted leading-relaxed mb-4">
                {study.data.tagline}
              </p>

              <!-- Single-Line High-Signal Outcome Strip (Clean baseline, unified font size) -->
              {keyOutcomes[study.id] && (
                <div
                  class="tldr-highlight mb-4 px-3.5 py-2.5 rounded-lg bg-surface-raised/70 border border-border/80 border-l-4 border-l-accent flex items-center gap-2.5 text-xs text-text overflow-hidden shadow-2xs"
                  title={`${keyOutcomes[study.id].badge} — ${keyOutcomes[study.id].text}`}
                >
                  <div class="shrink-0 flex items-center gap-2 text-xs font-mono font-bold text-accent">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                    <span>Outcome:</span>
                  </div>
                  <div class="min-w-0 flex-1 truncate text-xs text-text">
                    <span class="font-semibold text-text">{keyOutcomes[study.id].badge}</span>
                    <span class="text-text-muted mx-1.5">•</span>
                    <span>{keyOutcomes[study.id].text}</span>
                  </div>
                </div>
              )}

              {/* Tech Stack Badges with Authentic SVG Icons */}
              <div class="flex flex-wrap gap-2 mb-5">
                {study.data.stack.map((tech: string) => (
                  <span class="px-2.5 py-0.5 rounded-md bg-surface-raised border border-border text-xs font-mono text-text flex items-center gap-1.5">
                    <TechIcon name={tech} class="w-3.5 h-3.5 text-accent" />
                    <span>{tech}</span>
                  </span>
                ))}
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-border/60 text-sm">
              <a
                href={`/work/${study.id}`}
                class="font-medium text-accent hover:underline flex items-center gap-1"
              >
                Read case study →
              </a>

              <div class="flex items-center gap-4 text-xs font-mono">
                {study.data.liveUrl && (
                  <a
                    href={study.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-text transition-colors flex items-center gap-1"
                  >
                    Open live app ↗
                  </a>
                )}
                {study.data.repoUrl && (
                  <a
                    href={study.data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-text transition-colors flex items-center gap-1"
                  >
                    GitHub ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Interactive Architecture Section: Time-Machine Diff Slider -->
  <section id="architecture" class="py-8 sm:py-10 border-b border-border/60">
    <div class="mb-5">
      <h2 class="text-xs uppercase font-mono tracking-widest text-accent font-semibold mb-1">Engineering Walkthrough</h2>
      <p class="text-xl sm:text-2xl font-bold tracking-tight text-text">The Hard Part: Architecture & Schema Diff</p>
      <p class="text-xs text-text-muted mt-0.5 max-w-2xl">
        Interactive side-by-side diffs comparing flawed initial architectures against production fixes across UnitKo, Ledgerly, and TellHealth.
      </p>
    </div>

    <!-- Enhanced Interactive Diff Slider Component -->
    <div class="tldr-highlight rounded-2xl transition-all duration-300">
      <ArchitectureDiffSlider client:visible />
    </div>
  </section>

  <!-- About Section (Human-Centered & Honest) -->
  <section id="about" class="py-8 sm:py-10 border-b border-border/60">
    <div class="max-w-3xl">
      <h2 class="text-xs uppercase font-mono tracking-widest text-accent font-semibold mb-1">Background</h2>
      <p class="text-xl sm:text-2xl font-bold tracking-tight text-text mb-4">Engineering Ownership & Philosophy</p>

      <div class="space-y-3 text-text-muted text-sm leading-relaxed tldr-dim">
        <p>
          I am a full-stack engineer focused on distributed systems, offline-first architectures, and relational schema integrity. Currently interning as a software developer, with over 650 commits across three shipped applications.
        </p>
        <p>
          My focus is on eliminating manual failure modes: replacing error-prone spreadsheets with atomic offline-sync pipelines, fixing non-1NF array columns with strict PostgreSQL relational schemas, and ensuring systems behave predictably under adverse network conditions.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section (Compact Padding) -->
  <section id="contact" class="py-8 sm:py-10">
    <div class="p-6 sm:p-8 rounded-2xl border border-border bg-surface flex flex-col md:flex-row items-start md:items-center justify-between gap-5 shadow-xs">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text mb-1">Let's discuss engineering opportunities</h2>
        <p class="text-xs text-text-muted max-w-xl">
          Open to full-stack, frontend, or backend engineering positions. Direct contact:
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3 font-medium text-sm">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
          class="px-5 py-2.5 rounded-lg bg-accent text-accent-text hover:opacity-90 transition-opacity shadow-sm cursor-pointer flex items-center gap-2"
        >
          <TechIcon name="mail" class="w-4 h-4 text-accent-text" />
          <span>Send Message</span>
        </button>
        <a
          href="mailto:johnfelixmarc@gmail.com"
          class="px-4 py-2.5 rounded-lg border border-border hover:bg-surface-raised text-text-muted hover:text-text text-xs font-mono transition-colors"
          title="Direct mailto: link"
        >
          johnfelixmarc@gmail.com
        </a>
        <a
          href="https://github.com/jsbalabat"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 rounded-lg border border-border hover:bg-surface-raised text-text transition-colors flex items-center gap-2"
        >
          <TechIcon name="github" class="w-4 h-4 text-accent" />
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
