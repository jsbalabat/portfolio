---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import TechIcon from '../../components/icons/TechIcon.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout
  title={`${entry.data.title}: Architectural Case Study | Marc`}
  description={entry.data.tagline}
>
  <article class="max-w-5xl mx-auto py-5 sm:py-8">
    <!-- Back link -->
    <div class="mb-6 sm:mb-8">
      <a href="/#work" class="text-xs font-mono text-text-muted hover:text-text active:scale-[0.96] transition-all inline-flex items-center gap-1.5">
        ← Back to case studies
      </a>
    </div>

    <!-- Case Study Header -->
    <header class="border-b border-border/70 pb-6 sm:pb-8 mb-8 sm:mb-12">
      <div class="flex flex-wrap items-center gap-2 font-mono text-xs text-text-muted mb-3 sm:mb-4">
        <span class="font-bold text-accent tabular-nums">0{entry.data.order}</span>
        <span class="text-text-muted/40">/</span>
        <span>{entry.data.timeline}</span>
        <span class="text-text-muted/40">•</span>
        <span>{entry.data.role}</span>
      </div>

      <h1 class="text-2xl xs:text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-text mb-3 sm:mb-4 text-balance">
        {entry.data.title}
      </h1>

      <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-3xl mb-6 sm:mb-8 text-pretty">
        {entry.data.tagline}
      </p>

      <!-- Metadata & Live Links Bar -->
      <div class="p-4 sm:p-5 rounded-xl sm:rounded-2xl border border-border bg-surface flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
        <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
          {entry.data.stack.map((tech: string) => (
            <span class="px-2.5 py-1 rounded-lg bg-surface-raised border border-border text-xs font-mono text-text flex items-center gap-1.5">
              <TechIcon name={tech} class="w-3.5 h-3.5 text-accent" />
              <span>{tech}</span>
            </span>
          ))}
        </div>

        <div class="flex flex-wrap items-center gap-2.5 sm:gap-4 text-xs font-mono w-full sm:w-auto">
          {entry.data.liveUrl && (
            <a
              href={entry.data.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-lg bg-accent text-accent-text font-medium hover:opacity-90 active:scale-[0.96] transition-all shadow-xs"
            >
              Open Live App ↗
            </a>
          )}
          {entry.data.repoUrl && (
            <a
              href={entry.data.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-1.5 rounded-lg border border-border hover:bg-surface-raised active:scale-[0.96] transition-all"
            >
              View GitHub Repo ↗
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Case Study Markdown Content (With explicit mobile overflow containment) -->
    <div class="prose prose-zinc dark:prose-invert max-w-none text-text-muted leading-relaxed space-y-6 text-sm sm:text-base [&_h2]:text-xl sm:[&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-text [&_h2]:pt-6 sm:[&_h2]:pt-8 [&_h2]:border-t [&_h2]:border-border/40 [&_h3]:text-lg sm:[&_h3]:text-xl [&_h3]:font-semibold [&_h3]:text-text [&_p]:leading-relaxed [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-text-muted [&_ul]:list-disc [&_ul]:pl-5 sm:[&_ul]:pl-6 [&_ul]:space-y-2 [&_code]:font-mono [&_code]:text-xs [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:bg-surface-raised [&_code]:border [&_code]:border-border/60 [&_pre]:overflow-x-auto [&_pre]:max-w-full [&_pre]:p-3 sm:[&_pre]:p-4 [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-border/60 [&_table]:w-full [&_table]:overflow-x-auto [&_table]:block">
      <Content />
    </div>

    <!-- Case Study Footer -->
    <div class="mt-12 sm:mt-16 pt-6 sm:pt-8 border-t border-border flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <a href="/#work" class="text-sm font-medium text-accent hover:underline active:scale-[0.96] transition-all inline-flex items-center gap-1">
        ← Back to all projects
      </a>
      <button
        type="button"
        onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
        class="text-sm font-medium text-accent hover:underline active:scale-[0.96] transition-all cursor-pointer"
      >
        Discuss this architecture →
      </button>
    </div>
  </article>
</BaseLayout>
