  <!-- Interactive Profile Picture Color Toggle Script -->
  <script>
    const pictureToggle = document.getElementById('profile-picture-toggle');
    const pictureImg = document.getElementById('profile-picture-img');

    if (pictureToggle && pictureImg) {
      let isColor = false;

      const toggleColor = () => {
        isColor = !isColor;
        if (isColor) {
          // Latch to full color
          pictureImg.classList.remove('grayscale');
          pictureImg.classList.add('grayscale-0');
          pictureToggle.setAttribute('aria-pressed', 'true');
        } else {
          // Revert to default grayscale
          pictureImg.classList.remove('grayscale-0');
          pictureImg.classList.add('grayscale');
          pictureToggle.setAttribute('aria-pressed', 'false');
        }
      };

      pictureToggle.addEventListener('click', toggleColor);
    }
  </script>
