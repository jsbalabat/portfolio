---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// In production, hide draft posts. Sort newest first.
const posts = allPosts
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<BaseLayout
  title="Articles | Marc Balabat"
  description="Technical writing, architectural decisions, and production engineering notes by Marc Balabat."
  bodyClass="blog-theme"
  showHeader={false}
  showFooter={true}
  showAdminLogin={true}
>
  <div class="pt-8 sm:pt-12 pb-16">
    <!-- Top Bar with Back to Portfolio Navigation -->
    <nav class="flex items-center justify-between pb-6 mb-8 border-b border-border" aria-label="Articles navigation">
      <a
        href="/#blog"
        class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-border bg-surface hover:bg-surface-raised text-xs font-semibold uppercase tracking-wider text-text-muted hover:text-text transition-all group shadow-2xs"
      >
        <span class="group-hover:-translate-x-1 transition-transform">←</span>
        <span>Back to Portfolio</span>
      </a>

      <div class="text-[11px] font-mono text-text-muted uppercase tracking-widest">
        <span>{posts.length} {posts.length === 1 ? 'Article' : 'Articles'}</span>
      </div>
    </nav>

    <!-- Page Header -->
    <header class="mb-10 sm:mb-12">
      <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-2">
        TECHNICAL WRITING
      </span>
      <h1 class="font-display font-black text-4xl sm:text-6xl tracking-tight uppercase text-text text-balance">
        ARTICLES
      </h1>
      <p class="mt-3 text-sm sm:text-base text-text-muted max-w-2xl leading-relaxed text-pretty">
        Architecture walkthroughs, design tradeoffs, and technical breakdowns from production systems.
      </p>
    </header>

    <!-- Posts Grid -->
    {posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    ) : (
      <div class="p-8 sm:p-12 rounded-2xl border border-dashed border-border text-center text-text-muted">
        <p class="text-sm">No articles published yet. Check back soon.</p>
      </div>
    )}
  </div>
</BaseLayout>
