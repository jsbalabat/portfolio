---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechIcon from '../components/icons/TechIcon.astro';
import HomeBlogSection from '../components/HomeBlogSection.astro';
import { getCollection } from 'astro:content';

// Retrieve all projects, sorted by defined order
const rawProjects = await getCollection('projects');
const projects = rawProjects.sort((a, b) => a.data.order - b.data.order);

const skills = {
  Languages: ['TypeScript', 'JavaScript', 'Dart', 'PostgreSQL / SQL'],
  Frontend: ['React 19', 'Next.js', 'Astro 5', 'Tailwind CSS'],
  Backend: ['Node.js', 'Cloudflare Workers', 'Firebase'],
  Databases: ['PostgreSQL', 'Supabase', 'Cloudflare D1', 'Firestore'],
  Infrastructure: ['Docker Compose', 'GitHub Actions', 'Wrangler CLI'],
};
---

<BaseLayout>
  <!-- Hero Section (Full Viewport, Centered Two-Column Grid, Dynamic Viewport Fit) -->
  <section id="hero" class="relative flex flex-col justify-start pt-6 pb-12 sm:min-h-[100svh] sm:justify-center sm:py-12 lg:py-16 border-b border-border">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-start reveal-on-scroll sm:my-auto w-full">
      <!-- Left Column -->
      <div class="lg:col-span-6 flex flex-col justify-start space-y-4 sm:space-y-6">
        <!-- Status Row -->
        <div class="flex flex-wrap items-center justify-between gap-2.5 sm:gap-3 min-h-[28px]">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface text-xs text-text shadow-2xs">
            <span class="relative flex size-2 shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full size-2 bg-emerald-500"></span>
            </span>
            <span class="tracking-wide uppercase text-[10px] sm:text-[11px] font-semibold whitespace-nowrap">AVAILABLE FOR ROLES</span>
          </div>
          <div class="text-[11px] sm:text-xs text-text-muted font-medium uppercase tracking-wider whitespace-nowrap">
            <span>REMOTE</span>
          </div>
        </div>

        <!-- Display Headline -->
        <h1 class="font-display font-black text-6xl xs:text-7xl sm:text-7xl md:text-8xl lg:text-8xl 2xl:text-9xl tracking-tight leading-[0.88] sm:leading-[0.9] text-text uppercase text-balance">
          <span class="block">PRODUCTION</span>
          <span class="block">SYSTEMS THAT</span>
          <span class="block text-text-muted">NEVER BREAK.</span>
        </h1>
      </div>

      <!-- Right Column -->
      <div class="lg:col-span-6 flex flex-col justify-start space-y-4 sm:space-y-6">
        <!-- Identity Row -->
        <div class="flex items-center min-h-[28px]">
          <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold tracking-wide text-text-muted font-mono uppercase">
            <span>Hi, I'm Marc, a</span>
            <span id="hero-rotating-word" class="inline-block min-w-[20ch] text-text font-black transition-all duration-300">
              software engineer
            </span>
          </div>
        </div>

        <div class="space-y-2.5 sm:space-y-3.5">
          <h2 class="text-lg sm:text-2xl 2xl:text-3xl font-bold tracking-tight text-text text-balance leading-snug">
            Full-stack engineer specializing in resilient web applications, database architecture, and offline-first systems.
          </h2>
        </div>

        <!-- Action Buttons (Responsive & 44px min touch targets) -->
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 pt-2">
          <a
            id="explore-projects-btn"
            href="#projects"
            class="group inline-flex items-center justify-center min-h-[44px] gap-2 px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl bg-accent text-accent-text hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 text-xs font-bold uppercase tracking-wider text-center shadow-xs cursor-pointer touch-manipulation"
          >
            <span>Explore Projects</span>
            <span class="inline-block transition-transform duration-200 group-hover:translate-y-1">↓</span>
          </a>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
            class="inline-flex items-center justify-center min-h-[44px] px-4.5 sm:px-5 py-2.5 sm:py-3 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text transition-all text-xs font-semibold uppercase tracking-wider cursor-pointer touch-manipulation"
          >
            Get in Touch
          </button>
          <a
            href="https://github.com/jsbalabat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center min-h-[44px] px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider gap-1.5 touch-manipulation"
          >
            <TechIcon name="github" class="w-3.5 h-3.5" />
            <span>GitHub</span>
          </a>
          <a
            href="https://www.linkedin.com/in/marc-balabat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center min-h-[44px] px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider gap-1.5 touch-manipulation"
          >
            <TechIcon name="linkedin" class="w-3.5 h-3.5" />
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <section id="projects" class="pt-10 sm:pt-12 pb-20 sm:pb-24 border-b border-border scroll-mt-[43px]">
    <div class="flex items-end justify-between gap-3 mb-7 sm:mb-8 reveal-on-scroll">
      <div>
        <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1">
          SELECTED WORK ({projects.length < 10 ? `0${projects.length}` : projects.length})
        </span>
        <h2 class="font-display font-black text-4xl sm:text-6xl tracking-tight uppercase text-text text-balance">
          PROJECTS
        </h2>
      </div>
    </div>

    <!-- Projects List -->
    <div class="space-y-5">
      {projects.map((project, index) => {
        const num = index + 1;
        const indexStr = num < 10 ? `0${num}` : `${num}`;
        const totalStr = projects.length < 10 ? `0${projects.length}` : `${projects.length}`;

        return (
          <article
            class="group block p-5 sm:p-6 rounded-2xl border border-border bg-surface hover-card-lift hover:border-text-muted transition-all relative overflow-hidden shadow-xs reveal-on-scroll"
            transition:name={`project-card-${project.id}`}
          >
            <!-- Stretched Link to Project Details -->
            <a
              href={`/projects/${project.id}`}
              class="absolute inset-0 z-10"
              aria-label={`View ${project.data.title} project`}
            ></a>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 items-center">
              <!-- Left Column: Identity, Category, Title, Role -->
              <div class="lg:col-span-4 space-y-1.5">
                <div class="flex items-center gap-1.5 text-xs text-text-muted">
                  <span class="text-text font-bold tabular-nums">{indexStr}</span>
                  <span class="text-text-muted/50">/</span>
                  <span class="tabular-nums">{totalStr}</span>
                  <span class="text-border mx-0.5">•</span>
                  <span class="font-medium text-[11px] uppercase tracking-wider">{project.data.timeline}</span>
                </div>

                <span class="text-accent uppercase font-semibold tracking-wider text-[11px] block">
                  {project.data.category}
                </span>

                <h3
                  class="font-display font-black text-2xl sm:text-3xl uppercase tracking-tight text-text leading-tight group-hover:text-accent transition-colors"
                  transition:name={`project-title-${project.id}`}
                >
                  {project.data.title}
                </h3>

                <p class="text-xs text-text-muted uppercase tracking-wider font-medium">
                  Role: <span class="text-text font-semibold">{project.data.role}</span>
                </p>
              </div>

              <!-- Middle Column: Tagline & Key Metrics -->
              <div class="lg:col-span-4 space-y-2">
                <p class="text-sm font-medium text-text leading-snug">
                  {project.data.tagline}
                </p>

                {project.data.metrics && (
                  <span class="inline-block px-2.5 py-0.5 rounded-md bg-surface-raised border border-border-subtle text-[11px] text-text-muted font-medium tabular-nums">
                    {project.data.metrics}
                  </span>
                )}
              </div>

              <!-- Right Column: Skills Stack Pills & Direct Links -->
              <div class="lg:col-span-4 flex flex-col justify-between gap-3 pt-1 lg:pt-0">
                <div class="flex flex-wrap gap-1.5">
                  {project.data.stack.map((tech) => (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg border border-border-subtle bg-surface-raised text-[11px] text-text font-medium">
                      <TechIcon name={tech} class="w-3 h-3 text-text" />
                      <span>{tech}</span>
                    </span>
                  ))}
                </div>

                <!-- Direct Actions: Live Site & GitHub Repo -->
                <div class="flex flex-wrap items-center justify-end gap-2 pt-2 z-20">
                  {project.data.liveUrl && (
                    <a
                      href={project.data.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="min-h-[34px] px-3 py-1.5 inline-flex items-center gap-1.5 rounded-lg bg-accent text-accent-text text-[11px] font-bold uppercase tracking-wider hover:opacity-90 active:scale-95 transition-all shadow-xs whitespace-nowrap shrink-0 pointer-events-auto touch-manipulation"
                      title={`Open live site for ${project.data.title}`}
                    >
                      <span>Live Site</span>
                      <span class="text-xs leading-none">↗</span>
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a
                      href={project.data.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="min-h-[34px] px-3 py-1.5 inline-flex items-center gap-1.5 rounded-lg border border-border-subtle bg-surface-raised text-text hover:text-accent hover:border-text-muted active:scale-95 text-[11px] font-bold uppercase tracking-wider transition-colors whitespace-nowrap shrink-0 pointer-events-auto touch-manipulation"
                      title={`Open GitHub repository for ${project.data.title}`}
                    >
                      <TechIcon name="github" class="w-3 h-3 text-accent" />
                      <span>GitHub</span>
                      <span class="text-xs leading-none">↗</span>
                    </a>
                  )}
                  <span class="text-xs text-text-muted group-hover:text-accent transition-colors pl-1">
                    Details ↗
                  </span>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Engineering Blog Highlight Section -->
  <HomeBlogSection />

  <!-- Technical Stack Grid (Skills & Ecosystem) -->
  <section id="skills" class="py-14 sm:py-16 lg:py-20 border-b border-border scroll-mt-[43px]">
    <div class="mb-6 sm:mb-8 reveal-on-scroll">
      <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1">
        TOOLING & ECOSYSTEM
      </span>
      <h2 class="font-display font-black text-4xl sm:text-6xl tracking-tight uppercase text-text text-balance">
        TECHNICAL STACK
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 reveal-on-scroll">
      {Object.entries(skills).map(([category, items]) => (
        <div class="p-4 sm:p-5 rounded-2xl border border-border bg-surface flex flex-col justify-between hover-card-lift">
          <div>
            <h3 class="text-xs uppercase tracking-wider text-text font-bold pb-2.5 mb-2.5 border-b border-border">
              {category}
            </h3>
            <div class="flex flex-wrap gap-2 pt-1">
              {items.map((skillName) => (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-border-subtle bg-surface-raised text-xs text-text font-medium">
                  <TechIcon name={skillName} class="w-3.5 h-3.5 text-text" />
                  <span>{skillName}</span>
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact" class="py-14 sm:py-16 lg:py-20 text-center sm:text-left reveal-on-scroll scroll-mt-[43px]">
    <div class="max-w-3xl">
      <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1.5">
        CONTACT
      </span>
      <h2 class="font-display font-black text-5xl xs:text-6xl sm:text-7xl md:text-8xl tracking-tight leading-[0.92] uppercase text-text mb-6 text-balance">
        LET'S BUILD SOMETHING RELIABLE.
      </h2>

      <div class="flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center gap-2.5">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
          class="min-h-[44px] px-5 py-2.5 rounded-xl bg-accent text-accent-text hover:opacity-90 active:scale-[0.97] transition-all text-xs font-bold uppercase tracking-wider cursor-pointer shadow-xs flex items-center justify-center gap-1.5 touch-manipulation"
        >
          <span>Send Message</span>
          <span>✉</span>
        </button>
        <a
          href="mailto:johnfelixmarc@gmail.com"
          class="min-h-[44px] px-4 py-2.5 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center justify-center touch-manipulation text-center truncate"
        >
          johnfelixmarc@gmail.com
        </a>
        <div class="grid grid-cols-2 gap-2.5 sm:flex sm:items-center">
          <a
            href="https://github.com/jsbalabat"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] px-4 py-2.5 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-1.5 touch-manipulation"
          >
            <TechIcon name="github" class="w-3.5 h-3.5" />
            <span>GitHub</span>
          </a>
          <a
            href="https://www.linkedin.com/in/marc-balabat"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] px-4 py-2.5 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center justify-center gap-1.5 touch-manipulation"
          >
            <TechIcon name="linkedin" class="w-3.5 h-3.5" />
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  let intervalId: any = null;

  const initHeroRotator = () => {
    if (intervalId) clearInterval(intervalId);

    const el = document.getElementById("hero-rotating-word");
    if (!el) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.textContent = "software engineer";
      return;
    }

    const words = ["software engineer", "systems builder", "database architect"];
    let idx = 0;

    intervalId = setInterval(() => {
      idx = (idx + 1) % words.length;
      el.style.opacity = "0";
      el.style.transform = "translateY(-4px)";
      setTimeout(() => {
        el.textContent = words[idx];
        el.style.transform = "translateY(4px)";
        void el.offsetWidth;
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
      }, 300);
    }, 2400);
  };

  document.addEventListener("astro:page-load", initHeroRotator);
  document.addEventListener("astro:before-swap", () => {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }
  });
</script>
