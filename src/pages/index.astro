---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechIcon from '../components/icons/TechIcon.astro';
import { getCollection, render } from 'astro:content';

// Retrieve all projects, sorted by defined order
const rawProjects = await getCollection('projects');
const projects = rawProjects.sort((a, b) => a.data.order - b.data.order);

// Render markdown body for each project
const renderedProjects = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return { ...project, Content };
  })
);

const skills = {
  Languages: [
    { name: 'TypeScript', note: 'Strict typing, Zod validation' },
    { name: 'JavaScript', note: 'ESNext / Modern web APIs' },
    { name: 'Dart', note: 'Flutter cross-platform mobile' },
    { name: 'PostgreSQL / SQL', note: 'Relational DDL, indexes & queries' },
  ],
  Frontend: [
    { name: 'React 19', note: 'Hooks, Suspense & Server Components' },
    { name: 'Next.js', note: 'App Router & SSR performance' },
    { name: 'Astro 5', note: 'Content-first static architecture' },
    { name: 'Tailwind CSS', note: 'Tailwind 4 utility architecture' },
  ],
  Backend: [
    { name: 'Node.js', note: 'Long-running servers & runtime microservices' },
    { name: 'Cloudflare Workers', note: 'Edge compute & asset routing' },
    { name: 'Firebase', note: 'Idempotent Cloud Functions write paths' },
  ],
  Databases: [
    { name: 'PostgreSQL', note: 'Row-Level Security & 3NF normalization' },
    { name: 'Supabase', note: 'Auth, migrations & Postgres instances' },
    { name: 'Cloudflare D1', note: 'Edge-native distributed SQLite' },
    { name: 'Firestore', note: 'Document transactions & security rules' },
  ],
  Infrastructure: [
    { name: 'Docker Compose', note: 'Reproducible container environments' },
    { name: 'GitHub Actions', note: 'Automated CI/CD build & test pipelines' },
    { name: 'Wrangler CLI', note: 'Edge deployment & worker orchestration' },
  ],
};
---

<BaseLayout>
  <!-- Hero Section (Full Viewport, Centered Two-Column Grid, Dynamic Viewport Fit) -->
  <section id="hero" class="relative min-h-[100svh] min-h-[100dvh] flex flex-col justify-center py-6 sm:py-12 lg:py-16 border-b border-border">
    <!-- Top-Right Landing Controls (TLDR & Dark Mode, Aligned to Content Container) -->
    <div class="absolute top-3 sm:top-5 right-0 z-30 flex items-center gap-2">
      <!-- TLDR Toggle -->
      <button
        id="tldr-toggle-hero"
        data-tldr-toggle
        type="button"
        aria-pressed="false"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-border bg-surface hover:bg-surface-raised text-xs font-mono font-medium text-text transition-colors cursor-pointer shadow-2xs touch-manipulation select-none"
        title="Toggle TLDR: Dims detailed narrative and highlights key metrics, tech stacks, and project outcomes"
      >
        <span class="tldr-indicator size-1.5 rounded-full bg-text-muted/60 transition-colors shrink-0"></span>
        <span class="tracking-wider shrink-0">TLDR</span>
        <span class="tldr-badge w-7 min-w-[28px] text-[10px] py-0.5 rounded-md bg-surface-raised border border-border-subtle text-text-muted font-bold transition-colors inline-flex items-center justify-center text-center shrink-0">OFF</span>
      </button>

      <!-- Theme Toggle -->
      <button
        id="theme-toggle-hero"
        type="button"
        aria-label="Toggle color theme"
        title="Theme: System (default), Light, Dark"
        class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-border bg-surface hover:bg-surface-raised text-xs text-text transition-colors cursor-pointer shadow-2xs font-medium touch-manipulation select-none"
      >
        <span id="theme-toggle-hero-icon" class="text-accent">◐</span>
        <span id="theme-toggle-hero-text">System</span>
      </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-start reveal-on-scroll my-auto w-full">
      <!-- Left Column -->
      <div class="lg:col-span-6 flex flex-col justify-start space-y-4 sm:space-y-6">
        <!-- Status Row -->
        <div class="flex flex-wrap items-center justify-between gap-2.5 sm:gap-3 min-h-[28px]">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface text-xs text-text shadow-2xs">
            <span class="size-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
            <span class="tracking-wide uppercase text-[10px] sm:text-[11px] font-semibold whitespace-nowrap">AVAILABLE FOR NEW ROLES</span>
          </div>
          <div class="text-[11px] sm:text-xs text-text-muted font-medium uppercase tracking-wider whitespace-nowrap">
            <span>PHILIPPINES / REMOTE</span>
          </div>
        </div>

        <!-- Display Headline -->
        <h1 class="font-display font-black text-4xl xs:text-5xl sm:text-6xl md:text-7xl lg:text-8xl 2xl:text-9xl tracking-tight leading-[0.9] text-text uppercase">
          <span class="block">PRODUCTION</span>
          <span class="block">SYSTEMS THAT</span>
          <span class="block text-text-muted">NEVER BREAK.</span>
        </h1>
      </div>

      <!-- Right Column -->
      <div class="lg:col-span-6 flex flex-col justify-start space-y-4 sm:space-y-6">
        <!-- Identity Row (Aligned with Status Row baseline) -->
        <div class="flex items-center min-h-[28px]">
          <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold tracking-wide text-text-muted font-mono uppercase">
            <span>Hi, I'm</span>
            <span id="hero-rotating-word" class="text-text font-black transition-all duration-300">
              Marc
            </span>
          </div>
        </div>

        <div class="space-y-2.5 sm:space-y-3.5">
          <h2 class="text-lg sm:text-2xl 2xl:text-3xl font-bold tracking-tight text-text text-balance leading-snug">
            I design and build resilient digital products with zero patience for software that fails silently.
          </h2>
          <p class="text-xs sm:text-base text-text-muted leading-relaxed text-pretty font-normal tldr-dim">
            Sole engineer across four production applications with 700+ commits. I engineer systems where correctness and edge cases matter: replacing fragile Excel invoicing with offline-first mobile apps, eliminating cash waterfall drift with normalized relational schemas, and safeguarding clinical intake data with deterministic runtime validation.
          </p>
        </div>

        <!-- Metrics Strip -->
        <div class="metrics-strip grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 py-2.5 sm:py-4 border-y border-border transition-colors">
          <div>
            <span class="block text-2xl sm:text-4xl 2xl:text-5xl font-extrabold text-text tabular-nums tracking-tight">04</span>
            <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-text-muted font-semibold">Shipped Apps</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-4xl 2xl:text-5xl font-extrabold text-text tabular-nums tracking-tight">06</span>
            <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-text-muted font-semibold">Firms Adopted</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-4xl 2xl:text-5xl font-extrabold text-text tabular-nums tracking-tight">~150</span>
            <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-text-muted font-semibold">Daily Invoices</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-4xl 2xl:text-5xl font-extrabold text-text tabular-nums tracking-tight">100%</span>
            <span class="text-[10px] sm:text-[11px] uppercase tracking-wider text-text-muted font-semibold">RLS Isolation</span>
          </div>
        </div>

        <!-- Action Buttons (Responsive & 44px min touch targets) -->
        <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 pt-1 sm:pt-2">
          <a
            id="explore-projects-btn"
            href="#projects"
            class="group inline-flex items-center justify-center min-h-[44px] gap-2 px-5 sm:px-6 py-2.5 sm:py-3 rounded-xl bg-accent text-accent-text hover:scale-[1.02] active:scale-[0.98] transition-all duration-200 text-xs font-bold uppercase tracking-wider text-center shadow-xs cursor-pointer touch-manipulation"
          >
            <span>Explore Projects</span>
            <span class="inline-block transition-transform duration-200 group-hover:translate-y-1">↓</span>
          </a>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
            class="inline-flex items-center justify-center min-h-[44px] px-4.5 sm:px-5 py-2.5 sm:py-3 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text transition-all text-xs font-semibold uppercase tracking-wider cursor-pointer touch-manipulation"
          >
            Get in Touch
          </button>
          <a
            href="https://github.com/jsbalabat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center min-h-[44px] px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider gap-1.5 touch-manipulation"
          >
            <TechIcon name="github" class="w-3.5 h-3.5" />
            <span>GitHub</span>
          </a>
          <a
            href="https://www.linkedin.com/in/marc-balabat"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center min-h-[44px] px-3.5 sm:px-4 py-2.5 sm:py-3 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider gap-1.5 touch-manipulation"
          >
            <TechIcon name="linkedin" class="w-3.5 h-3.5" />
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section (Selected Works with Staggered Scroll-Reveals & Hover Lift) -->
  <section id="projects" class="pt-10 sm:pt-12 pb-24 sm:pb-28 lg:pb-32 border-b border-border scroll-mt-[43px]">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-7 sm:mb-8 reveal-on-scroll">
      <div>
        <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1">
          SELECTED WORK ({projects.length < 10 ? `0${projects.length}` : projects.length})
        </span>
        <h2 class="font-display font-black text-4xl sm:text-6xl tracking-tight uppercase text-text">
          PROJECTS
        </h2>
      </div>
      <p class="text-xs text-text-muted font-medium max-w-xs sm:text-right">
        Production systems designed, implemented, and deployed end-to-end.
      </p>
    </div>

    <!-- Projects List (Reduced vertical gaps, smooth card lift) -->
    <div class="space-y-6">
      {renderedProjects.map((project, index) => {
        const num = index + 1;
        const indexStr = num < 10 ? `0${num}` : `${num}`;
        const totalStr = projects.length < 10 ? `0${projects.length}` : `${projects.length}`;

        return (
          <article
            class="group block p-5 sm:p-6 rounded-2xl border border-border bg-surface hover-card-lift hover:border-text-muted transition-all relative overflow-hidden shadow-xs reveal-on-scroll"
            transition:name={`project-card-${project.id}`}
          >
            <!-- Stretched Link to Project Dossier -->
            <a
              href={`/projects/${project.id}`}
              class="absolute inset-0 z-10"
              aria-label={`View ${project.data.title} technical dossier`}
            ></a>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-6 items-stretch">
              <!-- Left Column (Identity, Title, Status) -->
              <div class="lg:col-span-3 space-y-2">
                <div class="flex flex-wrap items-center gap-1.5 text-xs text-text-muted">
                  <span class="text-text font-bold tabular-nums">{indexStr}</span>
                  <span class="text-text-muted/50">/</span>
                  <span class="tabular-nums">{totalStr}</span>
                  <span class="text-border mx-0.5">•</span>
                  <span class="font-medium text-[11px] uppercase tracking-wider whitespace-nowrap">{project.data.timeline}</span>
                </div>

                <span class="text-accent uppercase font-semibold tracking-wider text-[11px] block">
                  {project.data.category}
                </span>

                <h3
                  class="font-display font-black text-3xl sm:text-4xl uppercase tracking-tight text-text leading-tight group-hover:text-accent transition-colors"
                  transition:name={`project-title-${project.id}`}
                >
                  {project.data.title}
                </h3>

                <p class="text-xs text-text-muted uppercase tracking-wider font-medium">
                  Role: <span class="text-text font-semibold">{project.data.role}</span>
                </p>

                <div class="pt-1">
                  <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border border-border-subtle bg-surface-raised text-[10px] text-text font-semibold uppercase tracking-wider whitespace-nowrap">
                    <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
                    <span>PRODUCTION LIVE</span>
                  </div>
                </div>
              </div>

              <!-- Middle Column (Tagline, Narrative, Key Outcome) -->
              <div class="lg:col-span-6 space-y-2.5">
                <p class="text-sm sm:text-base font-medium text-text leading-snug">
                  {project.data.tagline}
                </p>

                <div class="text-xs sm:text-sm text-text-muted leading-relaxed prose prose-invert tldr-dim">
                  <project.Content />
                </div>

                <div class="pt-1.5 text-xs">
                  <span class="text-text-muted font-semibold uppercase text-[10px] tracking-wider block mb-1">Core Impact</span>
                  <p class="leading-relaxed text-text font-medium px-3 py-2 rounded-xl bg-surface-raised/50 border border-border-subtle tldr-highlight transition-all">
                    {project.data.keyOutcome}
                  </p>
                </div>
              </div>

              <!-- Right Column (Architectural Specs, Stack & Badges) -->
              <div class="lg:col-span-3 flex flex-col justify-between h-full pt-1 lg:pt-0">
                <div class="space-y-2.5">
                  <span class="text-[10px] uppercase tracking-wider text-text-muted font-bold block">ARCHITECTURE & STACK</span>
                  <div>
                    <span class="inline-block px-2.5 py-1 rounded-lg bg-surface-raised border border-border-subtle text-[11px] text-text font-semibold uppercase tracking-wider tldr-highlight transition-all">{project.data.metrics}</span>
                  </div>
                  <div class="flex flex-wrap gap-1.5 pt-0.5">
                    {project.data.stack.map((tech) => (
                      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-lg border border-border-subtle bg-surface-raised text-[11px] text-text font-medium">
                        <TechIcon name={tech} class="w-3 h-3 text-text" />
                        <span>{tech}</span>
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Bottom Right Actions & Marker -->
                <div class="pt-5 sm:pt-6 flex flex-wrap items-center justify-end gap-2 font-mono text-[10px] tracking-widest text-text-muted/50 select-none z-20">
                  {project.data.liveUrl && (
                    <a
                      href={project.data.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-accent text-accent-text text-[10px] font-bold uppercase tracking-wider hover:opacity-90 active:scale-95 transition-all shadow-xs whitespace-nowrap shrink-0 pointer-events-auto touch-manipulation"
                      title={`Open live site for ${project.data.title}`}
                    >
                      <span class="whitespace-nowrap leading-none">Live Site</span>
                      <span class="text-[11px] leading-none">↗</span>
                    </a>
                  )}
                  {project.data.repoUrl && (
                    <a
                      href={project.data.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg border border-border-subtle bg-surface-raised text-text-muted hover:text-text hover:border-text-muted text-[10px] font-semibold uppercase tracking-wider transition-colors whitespace-nowrap shrink-0 pointer-events-auto touch-manipulation"
                      title={`View source code for ${project.data.title}`}
                    >
                      <TechIcon name="github" class="w-2.5 h-2.5" />
                      <span>Repo</span>
                      <span class="text-[10px]">↗</span>
                    </a>
                  )}
                  <span class="inline group-hover:text-accent transition-colors whitespace-nowrap">SYS.ARCH // {indexStr}</span>
                  <span class="text-xs group-hover:text-accent transition-colors shrink-0">↗</span>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Technical Stack Bento Grid (Tightened, High-Contrast) -->
  <section id="skills" class="py-14 sm:py-16 lg:py-20 border-b border-border scroll-mt-[43px]">
    <div class="mb-6 sm:mb-8 reveal-on-scroll">
      <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1">
        TOOLING & ECOSYSTEM
      </span>
      <h2 class="font-display font-black text-4xl sm:text-6xl tracking-tight uppercase text-text">
        TECHNICAL STACK
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 reveal-on-scroll">
      {Object.entries(skills).map(([category, items]) => (
        <div class="p-4 sm:p-5 rounded-2xl border border-border bg-surface flex flex-col justify-between hover-card-lift">
          <div>
            <h3 class="text-xs uppercase tracking-wider text-text font-bold pb-2.5 mb-2.5 border-b border-border">
              {category}
            </h3>
            <ul class="space-y-2">
              {items.map((item) => (
                <li class="flex items-start justify-between gap-2 text-xs">
                  <span class="font-medium text-text flex items-center gap-1.5 shrink-0">
                    <TechIcon name={item.name} class="w-3.5 h-3.5 text-text" />
                    <span>{item.name}</span>
                  </span>
                  <span class="text-text-muted text-[11px] text-right truncate tldr-dim">
                    {item.note}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Closing Call to Action (Reduced excess space, Bold & Punchy) -->
  <section id="contact" class="py-14 sm:py-16 lg:py-20 text-center sm:text-left reveal-on-scroll scroll-mt-[43px]">
    <div class="max-w-3xl">
      <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1.5">
        NEXT STEPS
      </span>
      <h2 class="font-display font-black text-5xl xs:text-6xl sm:text-7xl md:text-8xl tracking-tight leading-[0.92] uppercase text-text mb-4 sm:mb-5">
        LET'S BUILD SOMETHING RELIABLE.
      </h2>
      <p class="text-sm sm:text-base text-text-muted max-w-2xl mb-6 leading-relaxed tldr-dim">
        Whether you are replacing fragmented legacy spreadsheets, architecting a multi-tenant platform, or launching a new product from scratch, I'm available for engineering roles and select contract work.
      </p>

      <div class="flex flex-wrap items-center gap-2.5">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
          class="px-5 py-2.5 rounded-xl bg-accent text-accent-text hover:opacity-90 active:scale-[0.97] transition-all text-xs font-bold uppercase tracking-wider cursor-pointer shadow-xs"
        >
          Send Message ✉
        </button>
        <a
          href="mailto:johnfelixmarc@gmail.com"
          class="px-4 py-2.5 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text transition-all text-xs font-semibold uppercase tracking-wider"
        >
          johnfelixmarc@gmail.com
        </a>
        <a
          href="https://github.com/jsbalabat"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5"
        >
          <TechIcon name="github" class="w-3.5 h-3.5" />
          <span>GitHub</span>
        </a>
        <a
          href="https://www.linkedin.com/in/marc-balabat"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-xl border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5"
        >
          <TechIcon name="linkedin" class="w-3.5 h-3.5" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  let intervalId: any = null;

  const initHeroRotator = () => {
    if (intervalId) clearInterval(intervalId);

    const el = document.getElementById("hero-rotating-word");
    if (!el) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.textContent = "Marc";
      return;
    }

    const words = ["Marc", "a developer", "a gamer", "a software engineer"];
    let idx = 0;

    intervalId = setInterval(() => {
      idx = (idx + 1) % words.length;
      el.style.opacity = "0";
      el.style.transform = "translateY(-4px)";
      setTimeout(() => {
        el.textContent = words[idx];
        el.style.transform = "translateY(4px)";
        void el.offsetWidth;
        el.style.opacity = "1";
        el.style.transform = "translateY(0)";
      }, 300);
    }, 2400);
  };

  document.addEventListener("astro:page-load", initHeroRotator);
  document.addEventListener("astro:before-swap", () => {
    if (intervalId) {
      clearInterval(intervalId);
      intervalId = null;
    }
  });
</script>
