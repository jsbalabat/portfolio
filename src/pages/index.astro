---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechIcon from '../components/icons/TechIcon.astro';
import { getCollection, render } from 'astro:content';

// Retrieve all projects, sorted by defined order
const rawProjects = await getCollection('projects');
const projects = rawProjects.sort((a, b) => a.data.order - b.data.order);

// Render markdown body for each project
const renderedProjects = await Promise.all(
  projects.map(async (project) => {
    const { Content } = await render(project);
    return { ...project, Content };
  })
);

const skills = {
  Languages: [
    { name: 'TypeScript', note: 'Strict typing, Zod validation' },
    { name: 'JavaScript', note: 'ESNext / Modern web APIs' },
    { name: 'Dart', note: 'Flutter cross-platform mobile' },
    { name: 'PostgreSQL / SQL', note: 'Relational DDL, indexes & queries' },
  ],
  Frontend: [
    { name: 'React 19', note: 'Hooks, Suspense & Server Components' },
    { name: 'Next.js', note: 'App Router & SSR performance' },
    { name: 'Astro 5', note: 'Content-first static architecture' },
    { name: 'Tailwind CSS', note: 'Tailwind 4 utility architecture' },
  ],
  Backend: [
    { name: 'Node.js', note: 'Long-running servers & runtime microservices' },
    { name: 'Cloudflare Workers', note: 'Edge compute & asset routing' },
    { name: 'Firebase', note: 'Idempotent Cloud Functions write paths' },
  ],
  Databases: [
    { name: 'PostgreSQL', note: 'Row-Level Security & 3NF normalization' },
    { name: 'Supabase', note: 'Auth, migrations & Postgres instances' },
    { name: 'Cloudflare D1', note: 'Edge-native distributed SQLite' },
    { name: 'Firestore', note: 'Document transactions & security rules' },
  ],
  Infrastructure: [
    { name: 'Docker Compose', note: 'Reproducible container environments' },
    { name: 'GitHub Actions', note: 'Automated CI/CD build & test pipelines' },
    { name: 'Wrangler CLI', note: 'Edge deployment & worker orchestration' },
  ],
};
---

<BaseLayout>
  <!-- Hero Section (Tightened spacing, High Contrast, Natural Sans Fonts) -->
  <section id="hero" class="pt-8 sm:pt-14 pb-12 sm:pb-16 border-b border-border">
    <!-- Top Status Row -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 sm:mb-8 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-border bg-surface text-xs text-text shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="tracking-wide uppercase text-[11px] font-semibold">AVAILABLE FOR NEW ROLES</span>
      </div>
      <div class="text-xs text-text-muted font-medium uppercase tracking-wider">
        <span>MANILA / REMOTE</span>
      </div>
    </div>

    <!-- Massive Display Headline (Tightened margin, high contrast uppercase) -->
    <div class="mb-8 sm:mb-10 reveal-on-scroll">
      <h1 class="font-display font-black text-5xl xs:text-6xl sm:text-7xl md:text-8xl lg:text-9xl tracking-tight leading-[0.92] text-text uppercase">
        <span class="block">PRODUCTION</span>
        <span class="block">SYSTEMS THAT</span>
        <span class="block text-text-muted">NEVER BREAK.</span>
      </h1>
    </div>

    <!-- Profile & Narrative Two-Column Block (Zero excess whitespace) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start reveal-on-scroll">
      <!-- Portrait Card -->
      <div class="lg:col-span-4">
        <div class="aspect-4/3 sm:aspect-square w-full max-w-xs sm:max-w-sm rounded-xl overflow-hidden border border-border bg-surface-raised relative group shadow-sm">
          <picture class="w-full h-full block">
            <source media="(min-width: 1024px)" srcset="/images/profile-desktop.jpg" />
            <source media="(min-width: 640px)" srcset="/images/profile-tablet.jpg" />
            <img
              src="/images/profile-mobile.jpg"
              alt="Marc Balabat - Full-Stack Engineer"
              class="w-full h-full object-cover object-[center_40%] filter grayscale contrast-110 group-hover:grayscale-0 group-hover:contrast-100 transition-all duration-500 ease-out"
              loading="eager"
            />
          </picture>
        </div>
      </div>

      <!-- Bio & CTAs -->
      <div class="lg:col-span-8 flex flex-col justify-between h-full space-y-5">
        <div class="space-y-3">
          <h2 class="text-lg sm:text-2xl font-bold tracking-tight text-text text-balance">
            I design and build resilient digital products with zero patience for software that fails silently.
          </h2>
          <p class="text-sm sm:text-base text-text-muted leading-relaxed max-w-2xl text-pretty font-normal">
            Sole engineer across three production applications with 650+ commits. I engineer systems where correctness and edge cases matter: replacing fragile Excel invoicing with offline-first mobile apps, eliminating cash waterfall drift with normalized relational schemas, and safeguarding clinical intake data with deterministic runtime validation.
          </p>
        </div>

        <!-- Metrics Strip (Tightened padding & borders, high contrast) -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 py-3.5 border-y border-border">
          <div>
            <span class="block text-2xl sm:text-3xl font-extrabold text-text tabular-nums tracking-tight">03</span>
            <span class="text-[11px] uppercase tracking-wider text-text-muted font-semibold">Shipped Apps</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-extrabold text-text tabular-nums tracking-tight">06</span>
            <span class="text-[11px] uppercase tracking-wider text-text-muted font-semibold">Firms Adopted</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-extrabold text-text tabular-nums tracking-tight">~150</span>
            <span class="text-[11px] uppercase tracking-wider text-text-muted font-semibold">Daily Invoices</span>
          </div>
          <div>
            <span class="block text-2xl sm:text-3xl font-extrabold text-text tabular-nums tracking-tight">100%</span>
            <span class="text-[11px] uppercase tracking-wider text-text-muted font-semibold">RLS Isolation</span>
          </div>
        </div>

        <!-- Action Buttons (Smooth physical press transitions) -->
        <div class="flex flex-wrap items-center gap-2.5 pt-1">
          <a
            href="#projects"
            class="px-5 py-2.5 rounded-lg bg-accent text-accent-text hover:opacity-90 active:scale-[0.97] transition-all text-xs font-bold uppercase tracking-wider text-center shadow-xs"
          >
            Explore Projects ↓
          </a>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
            class="px-4 py-2.5 rounded-lg border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text transition-all text-xs font-semibold uppercase tracking-wider cursor-pointer"
          >
            Get in Touch
          </button>
          <a
            href="https://github.com/jsbalabat"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5"
          >
            <TechIcon name="github" class="w-3.5 h-3.5" />
            <span>GitHub</span>
          </a>
          <a
            href="https://www.linkedin.com/in/marc-balabat"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2.5 rounded-lg border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5"
          >
            <TechIcon name="linkedin" class="w-3.5 h-3.5" />
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Projects Section (Selected Works with Staggered Scroll-Reveals & Hover Lift) -->
  <section id="projects" class="py-12 sm:py-16 border-b border-border">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 mb-8 sm:mb-12 reveal-on-scroll">
      <div>
        <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1">
          SELECTED WORK ({projects.length < 10 ? `0${projects.length}` : projects.length})
        </span>
        <h2 class="font-display font-black text-4xl sm:text-6xl tracking-tight uppercase text-text">
          PROJECTS
        </h2>
      </div>
      <p class="text-xs text-text-muted font-medium max-w-xs sm:text-right">
        Production systems designed, implemented, and deployed end-to-end.
      </p>
    </div>

    <!-- Projects List (Reduced vertical gaps, smooth card lift) -->
    <div class="space-y-6 sm:space-y-8">
      {renderedProjects.map((project, index) => {
        const num = index + 1;
        const indexStr = num < 10 ? `0${num}` : `${num}`;
        const totalStr = projects.length < 10 ? `0${projects.length}` : `${projects.length}`;

        return (
          <article class="p-5 sm:p-7 rounded-xl border border-border bg-surface hover-card-lift reveal-on-scroll shadow-xs">
            <!-- Project Top Metadata Row -->
            <div class="flex flex-wrap items-center justify-between gap-3 pb-3 mb-5 border-b border-border text-xs text-text-muted">
              <div class="flex items-center gap-2">
                <span class="text-text font-bold tabular-nums">{indexStr}</span>
                <span class="text-text-muted/60">/</span>
                <span class="tabular-nums">{totalStr}</span>
                <span class="mx-1 text-border">•</span>
                <span class="text-text uppercase font-semibold tracking-wider text-[11px]">{project.data.category}</span>
              </div>
              <div class="font-medium text-[11px] uppercase tracking-wider">
                <span>{project.data.timeline}</span>
              </div>
            </div>

            <!-- Title & Summary -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-start">
              <div class="lg:col-span-4">
                <h3 class="font-display font-black text-3xl sm:text-5xl uppercase tracking-tight text-text mb-2">
                  {project.data.title}
                </h3>
                <span class="inline-block px-2.5 py-1 rounded-md bg-surface-raised border border-border text-[11px] text-text font-semibold uppercase tracking-wider mb-3">
                  {project.data.metrics}
                </span>
                <p class="text-xs text-text-muted uppercase tracking-wider font-medium">
                  Role: <span class="text-text font-semibold">{project.data.role}</span>
                </p>
              </div>

              <div class="lg:col-span-8 space-y-3.5">
                <p class="text-sm sm:text-base text-text font-medium leading-snug">
                  {project.data.tagline}
                </p>

                <div class="text-xs sm:text-sm text-text-muted leading-relaxed prose prose-invert max-w-none">
                  <project.Content />
                </div>

                <!-- Tech Stack Chips -->
                <div class="pt-3 border-t border-border">
                  <span class="text-[10px] uppercase tracking-wider text-text-muted font-semibold block mb-1.5">
                    Technologies
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {project.data.stack.map((tech) => (
                      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border bg-surface-raised text-xs text-text font-medium transition-colors hover:border-text-muted">
                        <TechIcon name={tech} class="w-3.5 h-3.5 text-text" />
                        <span>{tech}</span>
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- About & Engineering Architecture Principles -->
  <section id="about" class="py-12 sm:py-16 border-b border-border">
    <div class="mb-8 sm:mb-10 reveal-on-scroll">
      <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1">
        ENGINEERING DISCIPLINE
      </span>
      <h2 class="font-display font-black text-4xl sm:text-6xl tracking-tight uppercase text-text">
        HOW I BUILD
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start mb-8 sm:mb-10 reveal-on-scroll">
      <div class="lg:col-span-5">
        <h3 class="text-lg sm:text-2xl font-bold tracking-tight text-text text-balance mb-3">
          Software exists to solve operational bottlenecks, not to showcase complexity.
        </h3>
        <p class="text-xs uppercase tracking-wider text-text-muted font-semibold mb-2">
          Zero ghost writes • Strict normalization • Offline resilience
        </p>
      </div>

      <div class="lg:col-span-7 space-y-3 text-sm sm:text-base text-text-muted leading-relaxed">
        <p>
          When a business operates on spreadsheets, disconnected tools, or manual reconciliations, failure isn't an edge case—it is a guarantee. Inventory numbers diverge, invoices collision, and monthly balance reconciliation turns into guesswork.
        </p>
        <p>
          I design software where invalid states are unrepresentable. I make the server authoritative over state transitions, use relational database constraints to prevent corrupt rows, and build interfaces that maintain zero latency and complete reliability even with spotty connectivity.
        </p>
      </div>
    </div>

    <!-- Core Principles Bento (Smooth Card Lift & High Contrast) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3.5 reveal-on-scroll">
      <div class="p-5 rounded-xl border border-border bg-surface hover-card-lift">
        <span class="text-xs uppercase text-accent font-bold tracking-wider block mb-1.5">01 / WRITE PATHS</span>
        <h4 class="text-base font-bold text-text mb-1.5">Idempotent Mutation Architecture</h4>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          Client apps request operations; atomic server functions execute them. Locks on database collections ensure inventory, document numbers, and customer balances cannot be manipulated by client shortcuts.
        </p>
      </div>

      <div class="p-5 rounded-xl border border-border bg-surface hover-card-lift">
        <span class="text-xs uppercase text-accent font-bold tracking-wider block mb-1.5">02 / DATA INTEGRITY</span>
        <h4 class="text-base font-bold text-text mb-1.5">3NF Schemas & RLS Isolation</h4>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          Multi-tenant applications require mathematical rigor. Normalized relational tables with foreign keys and strict Row-Level Security policies guarantee zero tenant data leakage and audit-ready precision.
        </p>
      </div>

      <div class="p-5 rounded-xl border border-border bg-surface hover-card-lift">
        <span class="text-xs uppercase text-accent font-bold tracking-wider block mb-1.5">03 / RESILIENCE</span>
        <h4 class="text-base font-bold text-text mb-1.5">Resilient Offline Queues</h4>
        <p class="text-xs sm:text-sm text-text-muted leading-relaxed">
          Workers operating in warehouses or on delivery routes cannot wait for signal. Local queues store encrypted transactions, warming catalogs at startup and flushing immediately upon reconnection.
        </p>
      </div>
    </div>
  </section>

  <!-- Technical Stack Bento Grid (Tightened, High-Contrast) -->
  <section id="skills" class="py-12 sm:py-16 border-b border-border">
    <div class="mb-8 sm:mb-10 reveal-on-scroll">
      <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1">
        TOOLING & ECOSYSTEM
      </span>
      <h2 class="font-display font-black text-4xl sm:text-6xl tracking-tight uppercase text-text">
        TECHNICAL STACK
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 reveal-on-scroll">
      {Object.entries(skills).map(([category, items]) => (
        <div class="p-4 sm:p-5 rounded-xl border border-border bg-surface flex flex-col justify-between hover-card-lift">
          <div>
            <h3 class="text-xs uppercase tracking-wider text-text font-bold pb-2.5 mb-2.5 border-b border-border">
              {category}
            </h3>
            <ul class="space-y-2">
              {items.map((item) => (
                <li class="flex items-start justify-between gap-2 text-xs">
                  <span class="font-medium text-text flex items-center gap-1.5 shrink-0">
                    <TechIcon name={item.name} class="w-3.5 h-3.5 text-text" />
                    <span>{item.name}</span>
                  </span>
                  <span class="text-text-muted text-[11px] text-right truncate">
                    {item.note}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Closing Call to Action (Reduced excess space, Bold & Punchy) -->
  <section id="contact" class="py-14 sm:py-20 text-center sm:text-left reveal-on-scroll">
    <div class="max-w-3xl">
      <span class="text-xs uppercase tracking-widest text-text-muted font-semibold block mb-1.5">
        NEXT STEPS
      </span>
      <h2 class="font-display font-black text-5xl xs:text-6xl sm:text-7xl md:text-8xl tracking-tight leading-[0.92] uppercase text-text mb-4 sm:mb-5">
        LET'S BUILD SOMETHING RELIABLE.
      </h2>
      <p class="text-sm sm:text-base text-text-muted max-w-xl mb-6 leading-relaxed">
        Whether you are replacing fragmented legacy spreadsheets, architecting a multi-tenant platform, or launching a new product from scratch, I'm available for engineering roles and select contract work.
      </p>

      <div class="flex flex-wrap items-center gap-2.5">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
          class="px-5 py-2.5 rounded-lg bg-accent text-accent-text hover:opacity-90 active:scale-[0.97] transition-all text-xs font-bold uppercase tracking-wider cursor-pointer shadow-xs"
        >
          Send Message ✉
        </button>
        <a
          href="mailto:johnfelixmarc@gmail.com"
          class="px-4 py-2.5 rounded-lg border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text transition-all text-xs font-semibold uppercase tracking-wider"
        >
          johnfelixmarc@gmail.com
        </a>
        <a
          href="https://github.com/jsbalabat"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-lg border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5"
        >
          <TechIcon name="github" class="w-3.5 h-3.5" />
          <span>GitHub</span>
        </a>
        <a
          href="https://www.linkedin.com/in/marc-balabat"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2.5 rounded-lg border border-border bg-surface hover:bg-surface-raised hover:border-text-muted active:scale-[0.97] text-text-muted hover:text-text transition-all text-xs font-semibold uppercase tracking-wider flex items-center gap-1.5"
        >
          <TechIcon name="linkedin" class="w-3.5 h-3.5" />
          <span>LinkedIn</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
