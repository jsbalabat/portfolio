---
// TransitionOpener: A tranquil, minimalist curtain reveal that gracefully opens upon landing
---

<div id="transition-opener" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-bg text-text select-none pointer-events-auto">
  <div class="max-w-md w-full px-6 flex flex-col items-center text-center space-y-4">
    <!-- Brand Mark -->
    <div class="flex items-center gap-3 font-mono text-xs text-text-muted tracking-widest uppercase">
      <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
      <span>Portfolio • 2026</span>
    </div>

    <!-- Main Opener Title -->
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text">
      Marc
    </h1>

    <p class="text-sm font-mono text-text-muted">
      Full-stack engineer • Production systems
    </p>

    <!-- Animated Progress / Sweep Line -->
    <div class="w-48 h-[2px] bg-border overflow-hidden rounded-full mt-2">
      <div id="opener-progress-bar" class="h-full bg-accent w-0"></div>
    </div>
  </div>
</div>

<style>
  #transition-opener {
    transition: transform 0.65s cubic-bezier(0.76, 0, 0.24, 1), opacity 0.5s ease;
  }

  #transition-opener.opener-dismissed {
    transform: translateY(-100%);
    pointer-events: none;
  }

  #opener-progress-bar {
    animation: openerSweep 0.55s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes openerSweep {
    0% {
      width: 0%;
    }
    100% {
      width: 100%;
    }
  }

  /* Immediate bypass if user prefers reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #transition-opener {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const opener = document.getElementById('transition-opener');
    if (!opener) return;

    // Check if user has already seen the opener in this session
    const hasSeen = sessionStorage.getItem('portfolio_opener_seen');
    if (hasSeen) {
      opener.style.display = 'none';
      return;
    }

    const dismiss = () => {
      opener.classList.add('opener-dismissed');
      sessionStorage.setItem('portfolio_opener_seen', 'true');
      setTimeout(() => {
        opener.style.display = 'none';
      }, 700);
    };

    // Auto dismiss after brief sweep (600ms)
    const timeout = setTimeout(dismiss, 650);

    // Or dismiss on user click/tap
    opener.addEventListener('click', () => {
      clearTimeout(timeout);
      dismiss();
    });
  })();
</script>
