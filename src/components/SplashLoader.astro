---
// src/components/SplashLoader.astro
// Minimalist initial loading splash screen
---

<div
  id="splash-loader"
  class="fixed inset-0 z-50 bg-bg flex flex-col items-center justify-center will-change-transform select-none"
  aria-hidden="true"
>
  <div class="flex flex-col items-center">
    <span class="font-display font-black text-4xl sm:text-5xl tracking-tight text-text uppercase">
      MARC
    </span>
    <span class="text-[11px] uppercase tracking-widest text-text-muted mt-2 font-medium">
      SYSTEMS & FULL-STACK ENGINEER
    </span>

    <!-- Progress Line Track -->
    <div class="w-40 h-[2px] bg-border overflow-hidden rounded-full mt-5 relative">
      <div id="splash-progress" class="h-full bg-accent rounded-full w-0 transition-all duration-500 ease-out"></div>
    </div>
  </div>
</div>

<script is:inline>
  if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('splash_shown')) {
    const splash = document.getElementById('splash-loader');
    if (splash) {
      splash.style.display = 'none';
      splash.style.transform = 'translateY(-100%)';
      splash.style.pointerEvents = 'none';
    }
  }
</script>

<script>
  let splashRunning = false;

  const runSplash = () => {
    const splash = document.getElementById('splash-loader');
    const progress = document.getElementById('splash-progress');

    if (!splash) return;

    if (sessionStorage.getItem('splash_shown')) {
      splash.style.display = 'none';
      splash.style.transform = 'translateY(-100%)';
      splash.style.pointerEvents = 'none';
      return;
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      splash.style.display = 'none';
      splash.style.pointerEvents = 'none';
      sessionStorage.setItem('splash_shown', 'true');
      return;
    }

    if (splashRunning) return;
    splashRunning = true;

    // Start progress bar animation
    requestAnimationFrame(() => {
      if (progress) {
        progress.style.width = '100%';
      }
    });

    const dismissSplash = () => {
      splash.style.transition = 'transform 0.7s cubic-bezier(0.77, 0, 0.175, 1)';
      splash.style.transform = 'translateY(-100%)';
      sessionStorage.setItem('splash_shown', 'true');
      splashRunning = false;
      setTimeout(() => {
        splash.style.display = 'none';
      }, 700);
    };

    if (document.readyState === 'complete') {
      setTimeout(dismissSplash, 500);
    } else {
      window.addEventListener('load', () => {
        setTimeout(dismissSplash, 400);
      }, { once: true });
      // Safety timeout after 700ms
      setTimeout(dismissSplash, 700);
    }
  };

  runSplash();
  document.addEventListener('astro:page-load', () => {
    if (sessionStorage.getItem('splash_shown')) {
      const splash = document.getElementById('splash-loader');
      if (splash) {
        splash.style.display = 'none';
        splash.style.transform = 'translateY(-100%)';
        splash.style.pointerEvents = 'none';
      }
    } else {
      runSplash();
    }
  });
</script>
