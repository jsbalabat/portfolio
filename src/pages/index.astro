---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureDiffSlider from '../components/pitched/ArchitectureDiffSlider';
import TechIcon from '../components/icons/TechIcon.astro';
import TldrToggle from '../components/TldrToggle';
import { getCollection } from 'astro:content';

// Retrieve all work case studies, sorted by defined order
const caseStudies = await getCollection('work');
caseStudies.sort((a, b) => a.data.order - b.data.order);

const skills = {
  Languages: [
    { name: 'TypeScript', note: 'Strict typing', highlight: true },
    { name: 'JavaScript', note: 'ESNext / Modern', highlight: false },
    { name: 'Dart', note: 'Flutter mobile', highlight: true },
    { name: 'PostgreSQL / SQL', note: 'Relational DDL & queries', highlight: true },
  ],
  Frontend: [
    { name: 'React 19', note: 'Hooks & Server Components', highlight: true },
    { name: 'Next.js', note: 'App Router & SSR', highlight: true },
    { name: 'Astro 5', note: 'Content collections & islands', highlight: false },
    { name: 'Tailwind CSS', note: 'Tailwind 4 CSS-first', highlight: false },
  ],
  Backend: [
    { name: 'Node.js', note: 'v22 Runtime', highlight: true },
    { name: 'Cloudflare Workers', note: 'Edge compute & assets', highlight: true },
    { name: 'Firebase', note: 'Cloud Functions write-path', highlight: true },
  ],
  Databases: [
    { name: 'PostgreSQL', note: 'Row-Level Security & 3NF', highlight: true },
    { name: 'Supabase', note: 'Auth & DB instances', highlight: true },
    { name: 'Cloudflare D1', note: 'Edge SQLite', highlight: false },
    { name: 'MongoDB Atlas', note: 'Document stores', highlight: false },
  ],
  Infrastructure: [
    { name: 'Docker Compose', note: 'Container orchestration', highlight: true },
    { name: 'GitHub Actions', note: 'Automated CI pipelines', highlight: false },
    { name: 'Wrangler CLI', note: 'Workers edge deployment', highlight: false },
  ],
};

const keyOutcomes: Record<string, { badge: string; text: string }> = {
  ledgerly: {
    badge: '6 Companies • ~150 Inv/Day',
    text: 'Replaced Excel billing via idempotent Cloud Functions write-path.',
  },
  unitko: {
    badge: '3NF Schema • Postgres RLS',
    text: 'Enforced tenant isolation and eliminated cash waterfall drift.',
  },
  'tell-health': {
    badge: '25/58 Retained • 6-Day Sprint',
    text: 'Deterministic Zod schema guardrails & PII scrub over LLM triage.',
  },
};
---

<BaseLayout>
  <!-- Full-Height Editorial Cover Page (Fluid full-screen on desktop, fitted on mobile) -->
  <section id="cover" class="min-h-[100dvh] py-3 sm:py-8 lg:py-12 border-b border-border/60 flex flex-col justify-between">
    <!-- Top Row: Cover Page Identity + Top-Right TLDR Toggle -->
    <div class="flex items-center justify-between w-full pt-1 pb-2">
      <div class="flex items-center gap-2 font-mono text-xs text-text-muted">
        <span class="inline-block w-2 h-2 rounded-full bg-accent"></span>
        <span class="font-bold text-sm tracking-tight text-text">Marc</span>
        <span class="text-text-muted/60">/</span>
        <span class="hidden xs:inline">systems & engineering</span>
      </div>
      <div class="flex items-center gap-2 sm:gap-2.5">
        <TldrToggle client:load />
        <!-- Landing Page Theme Toggle (Cycles: System -> Light -> Dark) -->
        <button
          id="theme-toggle-landing"
          type="button"
          aria-label="Toggle color theme (System, Light, Dark)"
          title="Theme: System (default), Light, Dark"
          class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg hover:bg-surface-raised active:scale-[0.96] border border-border text-xs font-mono text-text transition-all cursor-pointer shrink-0"
        >
          <span id="theme-toggle-landing-icon" class="text-accent">◐</span>
          <span id="theme-toggle-landing-text" class="hidden xs:inline">System</span>
        </button>
      </div>
    </div>

    <!-- Middle Content -->
    <div class="my-auto py-2 sm:py-4">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-8 items-center">
        
        <!-- Left Column: Picture, Identity, Headline, and CTAs -->
        <div class="lg:col-span-8 flex flex-col items-start text-left">
          <div class="flex items-center gap-2 px-3 py-1 rounded-md border border-border/80 bg-surface text-xs font-mono text-text-muted shadow-2xs mb-3 sm:mb-5">
            <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
            <span class="text-[11px] sm:text-xs">Full-stack software engineer • Sole developer</span>
          </div>

          <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-8 mb-4 sm:mb-6 w-full">
            <!-- Portrait Image (Full width on mobile, fluid square on tablet/desktop, toggles color on press) -->
            <div class="w-full sm:w-auto shrink-0">
              <button
                type="button"
                id="profile-picture-toggle"
                aria-label="Toggle profile photo color"
                aria-pressed="false"
                title="Click or tap to toggle photo color"
                class="w-full sm:w-44 md:w-52 lg:w-56 aspect-[4/3] sm:aspect-square rounded-2xl overflow-hidden border border-border shadow-sm bg-surface-raised relative group cursor-pointer active:scale-[0.98] transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent text-left block p-0"
              >
                <img
                  id="profile-picture-img"
                  src="/images/profile.jpg"
                  alt="Marc - Full-Stack Engineer"
                  class="w-full h-full object-cover object-[center_60%] sm:object-center filter grayscale contrast-105 group-hover:grayscale-0 transition-all duration-300 pointer-events-none select-none"
                  loading="eager"
                />
              </button>
            </div>

            <!-- Main Title -->
            <div class="flex-1 text-left">
              <h1 class="text-2xl xs:text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-text leading-[1.15] sm:leading-[1.1] text-balance">
                I build production systems that replace manual workflows.
              </h1>
            </div>
          </div>

          <p class="text-xs sm:text-base text-text-muted leading-relaxed mb-4 sm:mb-6 max-w-3xl text-pretty tldr-dim text-left">
            Sole engineer across three shipped products in 14 months with 650+ commits. I design systems where correctness and edge cases matter: replacing Excel billing for distribution companies, fixing schema normalization bugs, and building reliable offline-first pipelines.
          </p>

          <div class="grid grid-cols-2 sm:flex sm:flex-wrap sm:items-center gap-2 sm:gap-3 text-sm font-medium w-full sm:w-auto">
            <a
              href="#work"
              class="col-span-2 sm:col-auto px-4 sm:px-5 py-2.5 rounded-xl bg-accent text-accent-text hover:opacity-90 active:scale-[0.96] transition-all shadow-xs flex items-center justify-center gap-2 font-medium text-xs sm:text-sm text-center"
            >
              <span>Explore Case Studies</span>
              <span class="text-xs">↓</span>
            </a>
            <a
              href="#architecture"
              class="col-span-1 sm:col-auto px-3 sm:px-4 py-2.5 rounded-xl border border-border hover:bg-surface-raised active:scale-[0.96] text-text transition-all text-xs sm:text-sm flex items-center justify-center text-center"
            >
              <span class="sm:hidden">Schema Diff</span>
              <span class="hidden sm:inline">Schema Diff Playground</span>
            </a>
            <button
              type="button"
              onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
              class="col-span-1 sm:col-auto px-3 sm:px-4 py-2.5 rounded-xl border border-border hover:bg-surface-raised active:scale-[0.96] text-text transition-all cursor-pointer flex items-center justify-center gap-1.5 sm:gap-2 text-xs sm:text-sm"
            >
              <TechIcon name="mail" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-accent shrink-0" />
              <span>Get in Touch</span>
            </button>
            <a
              href="https://github.com/jsbalabat"
              target="_blank"
              rel="noopener noreferrer"
              class="col-span-1 sm:col-auto px-3 py-2 sm:px-3.5 sm:py-2.5 rounded-xl border border-border/70 hover:border-border hover:bg-surface-raised active:scale-[0.96] text-text-muted hover:text-text transition-all flex items-center justify-center gap-1.5 text-xs font-mono"
            >
              <TechIcon name="github" class="w-3.5 h-3.5 text-accent shrink-0" />
              <span>GitHub</span>
            </a>
            <a
              href="https://www.linkedin.com/in/marc-balabat"
              target="_blank"
              rel="noopener noreferrer"
              class="col-span-1 sm:col-auto px-3 py-2 sm:px-3.5 sm:py-2.5 rounded-xl border border-border/70 hover:border-border hover:bg-surface-raised active:scale-[0.96] text-text-muted hover:text-text transition-all flex items-center justify-center gap-1.5 text-xs font-mono"
            >
              <TechIcon name="linkedin" class="w-3.5 h-3.5 text-accent shrink-0" />
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Key Metrics Callout (Highlights in TLDR Mode) -->
        <div class="lg:col-span-4 grid grid-cols-3 lg:grid-cols-1 gap-2 sm:gap-3.5 w-full">
          <div class="tldr-highlight p-2.5 xs:p-3 sm:p-5 rounded-xl sm:rounded-2xl border border-border bg-surface shadow-xs transition-all duration-200 text-center sm:text-left">
            <span class="text-[9px] xs:text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-accent font-semibold block mb-0.5 sm:mb-1 truncate">
              <span class="hidden xs:inline">Shipped </span>Products
            </span>
            <p class="text-sm xs:text-base sm:text-2xl lg:text-3xl font-extrabold text-text tracking-tight tabular-nums">
              <span class="sm:hidden">3 Apps</span>
              <span class="hidden sm:inline">3 Applications</span>
            </p>
            <p class="hidden sm:block text-[11px] sm:text-xs text-text-muted mt-0.5 sm:mt-1 leading-relaxed">Sole engineer from architecture to deployment.</p>
          </div>

          <div class="tldr-highlight p-2.5 xs:p-3 sm:p-5 rounded-xl sm:rounded-2xl border border-border bg-surface shadow-xs transition-all duration-200 text-center sm:text-left">
            <span class="text-[9px] xs:text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-accent font-semibold block mb-0.5 sm:mb-1 truncate">
              <span class="hidden xs:inline">Commercial </span>Adoption
            </span>
            <p class="text-sm xs:text-base sm:text-2xl lg:text-3xl font-extrabold text-text tracking-tight tabular-nums">6 Companies</p>
            <p class="hidden sm:block text-[11px] sm:text-xs text-text-muted mt-0.5 sm:mt-1 leading-relaxed">Cleared ~150 invoices/day replacing Excel billing.</p>
          </div>

          <div class="tldr-highlight p-2.5 xs:p-3 sm:p-5 rounded-xl sm:rounded-2xl border border-border bg-surface shadow-xs transition-all duration-200 text-center sm:text-left">
            <span class="text-[9px] xs:text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-accent font-semibold block mb-0.5 sm:mb-1 truncate">
              <span class="hidden xs:inline">Verified </span>Git History
            </span>
            <p class="text-sm xs:text-base sm:text-2xl lg:text-3xl font-extrabold text-text tracking-tight tabular-nums">650+ Commits</p>
            <p class="hidden sm:block text-[11px] sm:text-xs text-text-muted mt-0.5 sm:mt-1 leading-relaxed">Continuous delivery over 14 months.</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Editorial Bottom Anchor / Scroll Prompt -->
    <div
      id="cover-bottom-anchor"
      class="pt-3 sm:pt-6 pb-1 sm:pb-2 flex items-center justify-between gap-2 border-t border-border/40 text-[11px] sm:text-xs font-mono text-text-muted transition-opacity duration-300"
    >
      <div id="open-to-roles-badge" class="flex items-center gap-1.5 sm:gap-2 truncate transition-opacity duration-300">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-500 shrink-0"></span>
        <span class="truncate">Open to full-stack, frontend, or backend roles</span>
      </div>
      <a
        id="cover-explore-btn"
        href="#skills"
        aria-label="Explore stack and tools"
        class="group flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg border border-transparent hover:border-border hover:bg-surface-raised active:scale-[0.96] transition-all duration-200 cursor-pointer text-text-muted hover:text-text shrink-0"
      >
        <span class="max-w-0 overflow-hidden whitespace-nowrap opacity-0 group-hover:max-w-xs group-hover:opacity-100 transition-all duration-200 text-xs font-mono font-medium text-accent">
          explore
        </span>
        <svg viewBox="0 0 24 24" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-text-muted group-hover:text-accent group-hover:translate-y-0.5 transition-all duration-200" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 9l6 6 6-6"/>
        </svg>
      </a>
    </div>
  </section>

  <!-- Production Tech Stack (Key tools highlight during TLDR Mode) -->
  <section id="skills" class="scroll-mt-20 py-8 sm:py-10 border-b border-border/60">
    <div class="mb-5 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <h2 class="text-xs uppercase font-mono tracking-widest text-accent font-semibold mb-1">Technical Proficiency</h2>
        <p class="text-xl sm:text-2xl font-bold tracking-tight text-text">Production Stack & Tools</p>
      </div>
      <p class="text-xs font-mono text-text-muted">
        Technologies in daily engineering and shipped products
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
      {Object.entries(skills).map(([category, items]) => (
        <div class="p-3.5 sm:p-5 rounded-xl sm:rounded-2xl border border-border bg-surface shadow-xs hover:border-accent/40 hover:shadow-sm transition-all duration-200 flex flex-col">
          <h3 class="text-xs font-mono font-bold text-accent uppercase tracking-wider mb-2.5 sm:mb-3 pb-1.5 border-b border-border/50">
            {category}
          </h3>
          <ul class="space-y-1.5 text-sm flex-1">
            {items.map((item) => (
              <li class={`flex items-center gap-2.5 px-2 py-1.5 rounded-lg transition-all duration-200 ${item.highlight ? 'tldr-highlight' : 'tldr-dim'}`}>
                <span class="w-7 h-7 rounded-md bg-surface-raised border border-border/60 flex items-center justify-center shrink-0 text-accent shadow-2xs">
                  <TechIcon name={item.name} class="w-3.5 h-3.5" />
                </span>
                <div class="min-w-0 flex-1">
                  <span class="font-medium text-xs text-text block truncate leading-tight">{item.name}</span>
                  <span class="text-[10px] text-text-muted block truncate mt-0.5 leading-tight">{item.note}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Shipped Case Studies (Outcomes & Metrics Pop during TLDR Mode) -->
  <section id="work" class="py-8 sm:py-10 border-b border-border/60">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 gap-2">
      <div>
        <h2 class="text-xs uppercase font-mono tracking-widest text-accent font-semibold mb-1">Deep Dives</h2>
        <p class="text-2xl sm:text-3xl font-extrabold tracking-tight text-text">Shipped Case Studies</p>
      </div>
      <p class="text-xs font-mono text-text-muted">
        Detailed architectural write-ups covering problem, system design, and bugs fixed
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 sm:gap-5">
      {caseStudies.map((study, index) => {
        const isPrimary = index === 0;
        const colSpan = isPrimary ? 'md:col-span-12' : 'md:col-span-6';

        return (
          <article
            class={`${colSpan} tldr-highlight rounded-xl sm:rounded-2xl border border-border bg-surface p-4 sm:p-7 flex flex-col justify-between hover:border-accent/60 transition-all duration-200 group shadow-xs`}
          >
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2 font-mono text-xs text-text-muted">
                  <span class="font-bold text-accent tabular-nums">0{study.data.order}</span>
                  <span class="text-text-muted/40">/</span>
                  <span>{study.data.timeline}</span>
                  <span class="text-text-muted/40">•</span>
                  <span>{study.data.role}</span>
                </div>
                {study.data.liveUrl && (
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-emerald-700 dark:text-emerald-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-500"></span>
                    Production
                  </span>
                )}
                {study.data.demoVideo && !study.data.liveUrl && (
                  <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-accent">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                    Video demo
                  </span>
                )}
              </div>

              <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-text group-hover:text-accent transition-colors mb-2 text-balance">
                <a href={`/work/${study.id}`} class="focus:outline-none">
                  {study.data.title}
                </a>
              </h3>

              <p class="text-sm text-text-muted leading-relaxed mb-4 text-pretty">
                {study.data.tagline}
              </p>

              <!-- Single-Line High-Signal Outcome Strip (Clean, neutral, no green area) -->
              {keyOutcomes[study.id] && (
                <div
                  class="tldr-highlight mb-4 px-3.5 py-2.5 rounded-xl bg-surface-raised/70 border border-border/80 flex items-center gap-2.5 text-xs text-text overflow-hidden shadow-2xs"
                  title={`${keyOutcomes[study.id].badge}: ${keyOutcomes[study.id].text}`}
                >
                  <div class="shrink-0 flex items-center text-xs font-mono font-bold text-accent">
                    <span>Outcome:</span>
                  </div>
                  <div class="min-w-0 flex-1 truncate text-xs text-text">
                    <span class="font-semibold text-text tabular-nums">{keyOutcomes[study.id].badge}</span>
                    <span class="text-text-muted mx-1.5">•</span>
                    <span>{keyOutcomes[study.id].text}</span>
                  </div>
                </div>
              )}

              {/* Tech Stack Badges with Authentic SVG Icons */}
              <div class="flex flex-wrap gap-1.5 mb-5">
                {study.data.stack.map((tech: string) => (
                  <span class="px-2 py-0.5 rounded-md bg-surface-raised/70 border border-border/60 text-xs font-mono text-text flex items-center gap-1.5">
                    <TechIcon name={tech} class="w-3.5 h-3.5 text-accent" />
                    <span>{tech}</span>
                  </span>
                ))}
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-border/60 text-sm">
              <a
                href={`/work/${study.id}`}
                class="font-medium text-accent hover:underline active:scale-[0.96] transition-all flex items-center gap-1.5"
              >
                <span>Read case study</span>
                <span class="text-xs transition-transform duration-200 group-hover:translate-x-0.5">→</span>
              </a>

              <div class="flex items-center gap-4 text-xs font-mono">
                {study.data.liveUrl && (
                  <a
                    href={study.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-text active:scale-[0.96] transition-all flex items-center gap-1"
                  >
                    Open live app ↗
                  </a>
                )}
                {study.data.repoUrl && (
                  <a
                    href={study.data.repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-text-muted hover:text-text active:scale-[0.96] transition-all flex items-center gap-1"
                  >
                    GitHub ↗
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Interactive Architecture Section: Time-Machine Diff Slider -->
  <section id="architecture" class="py-8 sm:py-10 border-b border-border/60">
    <div class="mb-5">
      <h2 class="text-xs uppercase font-mono tracking-widest text-accent font-semibold mb-1">Engineering Walkthrough</h2>
      <p class="text-xl sm:text-2xl font-bold tracking-tight text-text">The Hard Part: Architecture & Schema Diff</p>
      <p class="text-xs text-text-muted mt-0.5 max-w-2xl">
        Interactive side-by-side diffs comparing flawed initial architectures against production fixes across UnitKo, Ledgerly, and TellHealth.
      </p>
    </div>

    <!-- Enhanced Interactive Diff Slider Component -->
    <div class="tldr-highlight rounded-2xl transition-all duration-300">
      <ArchitectureDiffSlider client:visible />
    </div>
  </section>

  <!-- About Section (Human-Centered & Honest) -->
  <section id="about" class="py-8 sm:py-10 border-b border-border/60">
    <div class="max-w-3xl">
      <h2 class="text-xs uppercase font-mono tracking-widest text-accent font-semibold mb-1">Background</h2>
      <p class="text-xl sm:text-2xl font-bold tracking-tight text-text mb-4">Engineering Ownership & Philosophy</p>

      <div class="space-y-3 text-text-muted text-sm leading-relaxed tldr-dim">
        <p>
          I am a full-stack engineer focused on distributed systems, offline-first architectures, and relational schema integrity. Currently interning as a software developer, with over 650 commits across three shipped applications.
        </p>
        <p>
          My focus is on eliminating manual failure modes: replacing error-prone spreadsheets with atomic offline-sync pipelines, fixing non-1NF array columns with strict PostgreSQL relational schemas, and ensuring systems behave predictably under adverse network conditions.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section (Responsive Padding & Touch Targets) -->
  <section id="contact" class="py-8 sm:py-10">
    <div class="p-5 sm:p-8 rounded-xl sm:rounded-2xl border border-border bg-surface flex flex-col md:flex-row items-start md:items-center justify-between gap-5 shadow-xs">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-text mb-1 text-balance">Let's discuss engineering opportunities</h2>
        <p class="text-xs text-text-muted max-w-xl text-pretty">
          Open to full-stack, frontend, or backend engineering positions. Direct contact:
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2.5 sm:gap-3 font-medium text-sm w-full md:w-auto">
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
          class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-accent text-accent-text hover:opacity-90 active:scale-[0.96] transition-all shadow-sm cursor-pointer flex items-center justify-center gap-2 text-xs sm:text-sm font-medium"
        >
          <TechIcon name="mail" class="w-4 h-4 text-accent-text" />
          <span>Send Message</span>
        </button>
        <a
          href="mailto:johnfelixmarc@gmail.com"
          class="px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl border border-border hover:bg-surface-raised active:scale-[0.96] text-text-muted hover:text-text text-xs font-mono transition-all flex items-center gap-1.5"
          title="Direct mailto: link"
        >
          <span>johnfelixmarc@gmail.com</span>
        </a>
        <a
          href="https://github.com/jsbalabat"
          target="_blank"
          rel="noopener noreferrer"
          class="px-3 py-2 sm:px-4 sm:py-2.5 rounded-xl border border-border hover:bg-surface-raised active:scale-[0.96] text-text transition-all flex items-center gap-2 text-xs sm:text-sm"
        >
          <TechIcon name="github" class="w-4 h-4 text-accent" />
