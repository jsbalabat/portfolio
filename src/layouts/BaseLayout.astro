---
import '../styles/global.css';
import CommandPalette from '../components/pitched/CommandPalette';
import TldrToggle from '../components/TldrToggle';
import ContactModal from '../components/ContactModal';
import BackToTop from '../components/BackToTop.astro';
import TransitionOpener from '../components/TransitionOpener.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Marc | Full-Stack Software Engineer',
  description = 'Full-stack engineer who ships production systems that replace manual workflows. Sole engineer on three shipped products in 14 months.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://marcbalabat.tech');
const isHomepage = Astro.url.pathname === '/' || Astro.url.pathname === '';

const appVersion = import.meta.env.PUBLIC_APP_VERSION || '0.1.0';
const gitSha = import.meta.env.PUBLIC_GIT_SHA || 'dev';
const gitBranch = import.meta.env.PUBLIC_GIT_BRANCH || 'main';
const isProduction = gitBranch === 'main';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Tranquil Dark/Light/System Theme Script (Default: System) -->
    <script is:inline>
      const getStoredTheme = () => {
        try {
          // Clean up legacy binary theme key if present
          if (typeof localStorage !== 'undefined') {
            localStorage.removeItem('theme');
          }
          // Default option when loading in the website is always system
          if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('theme_preference')) {
            return sessionStorage.getItem('theme_preference');
          }
        } catch (e) {}
        return 'system';
      };

      const resolveTheme = (preference) => {
        if (preference === 'system') {
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        return preference;
      };

      const initialPref = getStoredTheme();
      const initialResolved = resolveTheme(initialPref);
      document.documentElement.setAttribute('data-theme', initialResolved);
      document.documentElement.setAttribute('data-theme-preference', initialPref);

      // Listen for system theme changes dynamically
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
        const currentPref = typeof sessionStorage !== 'undefined' ? (sessionStorage.getItem('theme_preference') || 'system') : 'system';
        if (currentPref === 'system') {
          document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        }
      });

      // Check TLDR mode preference on initial page load
      if (typeof localStorage !== 'undefined' && localStorage.getItem('portfolio_tldr_active') === 'true') {
        document.addEventListener('DOMContentLoaded', () => {
          document.body.classList.add('tldr-active');
        });
      }
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text antialiased selection:bg-accent/20 selection:text-accent">
    <!-- Top Transition Opener Curtain Reveal -->
    <TransitionOpener />

    <!-- Site Navigation (Fixed, backdrop-blurred, 0-100 fade halfway through cover page) -->
    <header
      id="site-header"
      class="fixed top-0 left-0 right-0 z-40 bg-bg/90 backdrop-blur-md border-b border-border/60 transition-opacity duration-150 pointer-events-none"
      style={isHomepage ? "opacity: 0;" : "opacity: 1; pointer-events: auto;"}
    >
      <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-8 lg:px-12 py-3.5 sm:py-4 flex items-center justify-between gap-4">
        <a href="/" class="group flex items-center gap-2.5 font-mono text-sm tracking-tight text-text">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-accent group-hover:scale-125 transition-transform duration-200"></span>
          <span class="font-bold text-lg tracking-tight">Marc</span>
          <span class="text-text-muted">/</span>
          <span class="text-text-muted text-xs font-mono">full-stack engineer</span>
        </a>

        <!-- Middle / Right Nav items -->
        <nav class="flex items-center gap-3 sm:gap-5 text-sm font-medium text-text-muted">
          <!-- TLDR Interactive Toggle Button -->
          <TldrToggle client:load />

          <a href="/#work" class="hover:text-text transition-colors">Case Studies</a>
          <a href="/#architecture" class="hover:text-text transition-colors">Architecture</a>
          <a href="/#skills" class="hover:text-text transition-colors">Stack</a>
          <a href="/#about" class="hover:text-text transition-colors">About</a>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
            class="hover:text-text transition-all active:scale-[0.96] cursor-pointer"
          >
            Contact
          </button>
          
          <!-- Command Palette Trigger -->
          <CommandPalette client:load />

          <!-- Theme Toggle (Cycles: System -> Light -> Dark) -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme (System, Light, Dark)"
            title="Theme: System (default), Light, Dark"
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg hover:bg-surface-raised active:scale-[0.96] border border-border text-xs font-mono text-text transition-all cursor-pointer"
          >
            <span id="theme-toggle-icon" class="text-accent">◐</span>
            <span id="theme-toggle-text">System</span>
          </button>
        </nav>
      </div>
    </header>

    <!-- Maximized Full-Width Container (eliminating excess lateral whitespace) -->
    <div class="w-full max-w-[1500px] mx-auto px-4 sm:px-8 lg:px-12 flex flex-col min-h-screen">
      <!-- Main Page Content -->
      <main class={`flex-1 ${isHomepage ? '' : 'pt-20 sm:pt-24 py-6 sm:py-8'}`}>
        <slot />
      </main>

      <!-- Site Footer -->
      <footer class="py-6 sm:py-8 border-t border-border/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-text-muted">
        <div class="flex flex-wrap items-center gap-3">
          <span>© {new Date().getFullYear()} Marc (jsbalabat).</span>
          <!-- Dynamic Version & Git SHA Status Pill -->
          <a
            href={gitSha !== 'dev' ? `https://github.com/jsbalabat/portfolio/commit/${gitSha}` : 'https://github.com/jsbalabat/portfolio'}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md border border-border/70 bg-surface hover:bg-surface-raised hover:border-border text-[11px] font-mono text-text-muted hover:text-text transition-all active:scale-[0.96]"
            title={`Deployed from ${gitBranch} branch (${gitSha})`}
          >
            <span class={`w-1.5 h-1.5 rounded-full ${isProduction ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
            <span>v{appVersion}</span>
            <span class="text-text-muted/40">·</span>
            <span class="text-text font-medium">{gitSha}</span>
            {!isProduction && (
              <span class="text-[10px] text-accent font-normal">({gitBranch})</span>
            )}
          </a>
        </div>
        <div class="flex items-center gap-4">
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
            class="hover:text-text transition-colors cursor-pointer text-left underline decoration-accent/40 hover:decoration-accent"
            title="Open email contact popup"
          >
            johnfelixmarc@gmail.com
          </button>
          <span>•</span>
          <a href="https://github.com/jsbalabat" target="_blank" rel="noopener noreferrer" class="hover:text-text transition-colors">GitHub</a>
          <span>•</span>
          <a href="https://www.linkedin.com/in/marc-balabat" target="_blank" rel="noopener noreferrer" class="hover:text-text transition-colors">LinkedIn</a>
          <span>•</span>
          <span class="inline-flex items-center gap-1.5 text-accent font-medium">
            Cloudflare Workers Runtime
          </span>
        </div>
      </footer>
    </div>

    <!-- Floating Back to Top Button -->
    <BackToTop />

    <!-- Contact Email Modal Popup -->
    <ContactModal client:load />

    <!-- Theme Toggle & TLDR Toast Dismiss Scripts -->
    <script>
      const getActiveThemePreference = (): string => {
        try {
          if (typeof sessionStorage !== 'undefined') {
            const stored = sessionStorage.getItem('theme_preference');
            if (stored) return stored;
          }
        } catch (e) {}
        return 'system';
      };

      const updateThemeToggleUI = () => {
        const pref = getActiveThemePreference();
        const iconEl = document.getElementById('theme-toggle-icon');
        const textEl = document.getElementById('theme-toggle-text');
        const btn = document.getElementById('theme-toggle');
        if (!iconEl || !textEl || !btn) return;

        if (pref === 'system') {
          iconEl.textContent = '◐';
          textEl.textContent = 'System';
          btn.setAttribute('title', 'Theme: System (Default Auto)');
        } else if (pref === 'light') {
          iconEl.textContent = '☼';
          textEl.textContent = 'Light';
          btn.setAttribute('title', 'Theme: Light');
        } else {
          iconEl.textContent = '☾';
          textEl.textContent = 'Dark';
          btn.setAttribute('title', 'Theme: Dark');
        }
      };

      const applyThemePreference = (nextPref: string) => {
        try {
          sessionStorage.setItem('theme_preference', nextPref);
        } catch (e) {}
        document.documentElement.setAttribute('data-theme-preference', nextPref);
        if (nextPref === 'system') {
          const resolved = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', resolved);
        } else {
          document.documentElement.setAttribute('data-theme', nextPref);
        }
        updateThemeToggleUI();
        window.dispatchEvent(new CustomEvent('theme-preference-change', { detail: nextPref }));
      };

      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        updateThemeToggleUI();
        toggle.addEventListener('click', () => {
          const currentPref = getActiveThemePreference();
          const cycle: Record<string, string> = {
            system: 'light',
            light: 'dark',
            dark: 'system',
          };
          const next = cycle[currentPref] || 'system';
          applyThemePreference(next);
        });
      }

      window.addEventListener('theme-preference-change', () => {
        updateThemeToggleUI();
      });

      // Dynamic header fade-in: 0-100 halfway through cover page onwards
      const header = document.getElementById('site-header');
      const cover = document.getElementById('cover');

      if (header && cover) {
        const updateHeader = () => {
          const coverHeight = cover.offsetHeight || window.innerHeight;
          const halfway = coverHeight * 0.5;
          const scrollY = window.scrollY || window.pageYOffset || 0;

          if (scrollY <= halfway) {
            header.style.opacity = '0';
            header.style.pointerEvents = 'none';
          } else if (scrollY >= coverHeight) {
            header.style.opacity = '1';
            header.style.pointerEvents = 'auto';
          } else {
            const progress = (scrollY - halfway) / (coverHeight - halfway);
            const clamped = Math.max(0, Math.min(1, progress));
            header.style.opacity = clamped.toFixed(3);
            header.style.pointerEvents = clamped > 0.15 ? 'auto' : 'none';
          }
        };

        window.addEventListener('scroll', updateHeader, { passive: true });
        window.addEventListener('resize', updateHeader, { passive: true });
        updateHeader();
      } else if (header) {
        header.style.opacity = '1';
        header.style.pointerEvents = 'auto';
      }
    </script>
  </body>
</html>
