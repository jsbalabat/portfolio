---
import "../styles/global.css";
import ContactModal from "../components/ContactModal";
import BackToTop from "../components/BackToTop.astro";
import SplashLoader from "../components/SplashLoader.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marc | Full-Stack Software Engineer",
  description = "Full-stack engineer specializing in reliable production systems, database architecture, and replacing fragmented workflows.",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://marcbalabat.tech",
);

const appVersion = import.meta.env.PUBLIC_APP_VERSION || "1.0.1";
const gitSha = import.meta.env.PUBLIC_GIT_SHA || "dev";
const gitBranch = import.meta.env.PUBLIC_GIT_BRANCH || "main";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Google Fonts: DM Sans (Human/Natural Sans) & Alumni Sans (Display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alumni+Sans:ital,wght@0,700;0,800;0,900;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />

    <!-- Theme Initialization Script -->
    <script is:inline>
      const getStoredTheme = () => {
        try {
          if (typeof sessionStorage !== "undefined" && sessionStorage.getItem("theme_preference")) {
            return sessionStorage.getItem("theme_preference");
          }
        } catch (e) {}
        return "system";
      };

      const resolveTheme = (preference) => {
        if (preference === "system") {
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        return preference;
      };

      const applyTheme = () => {
        const pref = getStoredTheme();
        document.documentElement.setAttribute("data-theme", resolveTheme(pref));
        document.documentElement.setAttribute("data-theme-preference", pref);
      };

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);

      const applyTldr = () => {
        try {
          if (localStorage.getItem("portfolio_tldr_active") === "true") {
            document.documentElement.classList.add("tldr-active");
          } else {
            document.documentElement.classList.remove("tldr-active");
          }
        } catch (e) {}
      };
      applyTldr();
      document.addEventListener("astro:after-swap", applyTldr);

      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
        if ((sessionStorage.getItem("theme_preference") || "system") === "system") {
          document.documentElement.setAttribute("data-theme", e.matches ? "dark" : "light");
        }
      });
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text antialiased selection:bg-accent selection:text-accent-text">
    <SplashLoader />

    <!-- Background Technical Flair: Left & Right Rails -->
    <aside
      aria-hidden="true"
      class="pointer-events-none fixed top-0 bottom-0 left-2 xl:left-5 z-0 hidden lg:flex flex-col justify-between items-center py-12 text-text-muted/30 select-none font-mono text-[9px] tracking-widest uppercase"
    >
      <!-- Top: Reticle + Lat -->
      <div class="flex flex-col items-center gap-2">
        <svg class="w-3.5 h-3.5 text-text-muted/40 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
          <circle cx="8" cy="8" r="5" stroke-dasharray="2 2"></circle>
          <line x1="8" y1="1" x2="8" y2="15"></line>
          <line x1="1" y1="8" x2="15" y2="8"></line>
        </svg>
        <span class="[writing-mode:vertical-rl] rotate-180">SYS.01 // LAT 14.5995° N</span>
      </div>

      <!-- Middle: Vertical measurement tick marks line -->
      <div class="h-48 w-[1px] bg-border-subtle relative flex flex-col justify-between items-center">
        <span class="w-2 h-[1px] bg-border-subtle"></span>
        <span class="w-1.5 h-[1px] bg-border-subtle"></span>
        <span class="w-3 h-[1px] bg-text-muted/40"></span>
        <span class="w-1.5 h-[1px] bg-border-subtle"></span>
        <span class="w-2 h-[1px] bg-border-subtle"></span>
      </div>

      <!-- Bottom: PROD_SYS // ACTIVE -->
      <div class="flex flex-col items-center gap-2">
        <span class="[writing-mode:vertical-rl] rotate-180">PROD_SYS // ACTIVE</span>
        <div class="w-1.5 h-1.5 rounded-full bg-emerald-500/40"></div>
      </div>
    </aside>

    <aside
      aria-hidden="true"
      class="pointer-events-none fixed top-0 bottom-0 right-2 xl:right-5 z-0 hidden lg:flex flex-col justify-between items-center py-12 text-text-muted/30 select-none font-mono text-[9px] tracking-widest uppercase"
    >
      <!-- Top: Longitude + 3NF -->
      <div class="flex flex-col items-center gap-2">
        <div class="w-1.5 h-1.5 rounded-full bg-accent/40"></div>
        <span class="[writing-mode:vertical-rl]">LNG 120.9842° E // 3NF</span>
      </div>

      <!-- Middle: Vertical measurement line with coordinate marks -->
      <div class="h-48 w-[1px] bg-border-subtle relative flex flex-col justify-between items-center">
        <span class="w-2 h-[1px] bg-border-subtle"></span>
        <span class="w-1.5 h-[1px] bg-border-subtle"></span>
        <span class="w-3 h-[1px] bg-text-muted/40"></span>
        <span class="w-1.5 h-[1px] bg-border-subtle"></span>
        <span class="w-2 h-[1px] bg-border-subtle"></span>
      </div>

      <!-- Bottom: Technical crosshair SVG + telemetry status -->
      <div class="flex flex-col items-center gap-2">
        <span class="[writing-mode:vertical-rl]">TELEMETRY // OK</span>
        <svg class="w-3.5 h-3.5 text-text-muted/40 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2">
          <rect x="3" y="3" width="10" height="10" stroke-dasharray="2 2"></rect>
          <line x1="8" y1="2" x2="8" y2="14"></line>
          <line x1="2" y1="8" x2="14" y2="8"></line>
        </svg>
      </div>
    </aside>

    <!-- Dynamic Header (Reveals on scroll) -->
    <!-- Dynamic Header (Reveals on scroll) -->
    <header
      id="site-header"
      class="fixed top-0 left-0 right-0 z-40 bg-bg/90 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none -translate-y-2 pt-[env(safe-area-inset-top,0px)] border-b border-border/40"
    >
      <div class="w-[90%] mx-auto px-4 sm:px-6 py-2.5 sm:py-3 flex items-center justify-between gap-4">
        <a href="/" class="group flex items-center gap-2 text-sm tracking-tight text-text shrink-0 touch-manipulation">
          <span class="inline-block size-2 rounded-full bg-accent group-hover:scale-125 transition-transform duration-200 shrink-0"></span>
          <span class="font-bold text-base tracking-tight">MARC</span>
          <span class="text-text-muted/60 hidden sm:inline">/</span>
          <span class="text-text-muted text-xs font-medium tracking-normal hidden sm:inline">SOFTWARE ENGINEER</span>
        </a>

        <!-- Desktop Navigation Items -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-semibold uppercase tracking-wider text-text-muted">
          <a href="/#projects" class="hover:text-text transition-colors">Projects</a>
          <a href="/#skills" class="hover:text-text transition-colors">Stack</a>
          <a href="/#contact" class="hover:text-text transition-colors">Contact</a>

          <!-- TLDR Toggle in Header -->
          <button
            id="tldr-toggle-header"
            data-tldr-toggle
            type="button"
            aria-pressed="false"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg border border-border bg-surface hover:bg-surface-raised text-xs font-mono font-medium text-text transition-colors cursor-pointer shadow-2xs shrink-0 select-none"
            title="Toggle TLDR: Dims detailed narrative and highlights key metrics, tech stacks, and project outcomes"
          >
            <span class="tldr-indicator size-1.5 rounded-full bg-text-muted/60 transition-colors shrink-0"></span>
            <span class="tracking-wider shrink-0">TLDR</span>
            <span class="tldr-badge w-7 min-w-[28px] text-[10px] py-0.5 rounded-md bg-surface-raised border border-border-subtle text-text-muted font-bold transition-colors inline-flex items-center justify-center text-center shrink-0">OFF</span>
          </button>

          <!-- Theme Toggle (System -> Light -> Dark) -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            title="Theme: System (default), Light, Dark"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg hover:bg-surface-raised active:scale-[0.96] border border-border text-xs text-text transition-all cursor-pointer shrink-0 font-medium"
          >
            <span id="theme-toggle-icon" class="text-accent">◐</span>
            <span id="theme-toggle-text">System</span>
          </button>
        </nav>

        <!-- Mobile Controls (44x44px minimum touch targets) -->
        <div class="flex md:hidden items-center gap-1.5 shrink-0">
          <button
            id="tldr-toggle-mobile"
            data-tldr-toggle
            type="button"
            aria-label="Toggle TLDR mode"
            class="inline-flex items-center justify-center size-10 min-w-[44px] min-h-[44px] rounded-xl hover:bg-surface-raised active:bg-surface-raised active:scale-90 border border-border text-xs font-mono font-bold text-text cursor-pointer transition-transform touch-manipulation gap-1"
            title="Toggle TLDR"
          >
            <span class="tldr-indicator size-1.5 rounded-full bg-text-muted/60 transition-colors"></span>
            <span>TLDR</span>
          </button>

          <button
            id="theme-toggle-mobile"
            type="button"
            aria-label="Toggle color theme"
            class="inline-flex items-center justify-center size-10 min-w-[44px] min-h-[44px] rounded-xl hover:bg-surface-raised active:bg-surface-raised active:scale-90 border border-border text-sm text-text cursor-pointer transition-transform touch-manipulation"
          >
            <span id="theme-toggle-mobile-icon">◐</span>
          </button>

          <button
            id="mobile-menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Toggle navigation menu"
            class="inline-flex items-center justify-center size-10 min-w-[44px] min-h-[44px] rounded-xl border border-border bg-surface hover:bg-surface-raised active:bg-surface-raised active:scale-90 text-text cursor-pointer transition-transform touch-manipulation"
          >
            <svg id="hamburger-icon" class="size-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line id="line-top" x1="4" y1="6" x2="20" y2="6" class="transition-transform duration-300 origin-center"></line>
              <line id="line-mid" x1="4" y1="12" x2="20" y2="12" class="transition-opacity duration-200"></line>
              <line id="line-bot" x1="4" y1="18" x2="20" y2="18" class="transition-transform duration-300 origin-center"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer (Smooth CSS Grid & Opacity Animation) -->
      <div
        id="mobile-menu"
        class="md:hidden grid grid-rows-[0fr] transition-[grid-template-rows,opacity] duration-200 ease-out opacity-0 pointer-events-none w-full border-t border-border/0 bg-bg/98 backdrop-blur-md"
      >
        <div class="overflow-hidden">
          <div
            id="mobile-menu-content"
            class="w-[90%] mx-auto px-4 py-3 flex flex-col space-y-1 text-xs uppercase font-medium text-text transition-transform duration-200 -translate-y-2"
          >
            <a href="/#projects" class="mobile-nav-link min-h-[44px] flex items-center px-3 py-2 rounded-lg hover:bg-surface-raised active:bg-surface-raised hover:text-text transition-colors touch-manipulation">Projects</a>
            <a href="/#skills" class="mobile-nav-link min-h-[44px] flex items-center px-3 py-2 rounded-lg hover:bg-surface-raised active:bg-surface-raised hover:text-text transition-colors touch-manipulation">Stack</a>
            <a href="/#contact" class="mobile-nav-link min-h-[44px] flex items-center px-3 py-2 rounded-lg hover:bg-surface-raised active:bg-surface-raised hover:text-text transition-colors touch-manipulation">Contact</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container (Tightened max-w-5xl to reduce dead empty lateral margin) -->
    <div class="w-[90%] mx-auto px-4 sm:px-6 flex flex-col min-h-dvh">
      <main class="flex-1">
        <slot />
      </main>

      <!-- Minimalist Editorial Footer -->
      <footer class="py-8 border-t border-border flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-text-muted pb-[calc(2rem+env(safe-area-inset-bottom,0px))]">
        <div class="flex flex-col gap-0.5">
          <div class="flex items-center gap-2">
            <span class="size-2 rounded-full bg-emerald-500"></span>
            <span class="text-text font-semibold uppercase tracking-wider text-[11px]">AVAILABLE FOR NEW OPPORTUNITIES</span>
          </div>
          <p>© {new Date().getFullYear()} Marc Balabat. v{appVersion} · {gitSha} ({gitBranch})</p>
        </div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 uppercase tracking-wider text-text font-medium text-[11px]">
          <a href="https://github.com/jsbalabat" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/marc-balabat" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
            class="hover:text-accent transition-colors cursor-pointer uppercase"
          >
            Email
          </button>
        </div>
      </footer>
    </div>

    <!-- Long Capsule Pill Custom Scrollbar -->
    <div
      id="custom-scrollbar"
      aria-hidden="true"
      class="fixed right-2 sm:right-3.5 top-1/3 bottom-1/3 w-1 sm:w-1.5 rounded-full bg-border/40 overflow-hidden pointer-events-none z-40 hidden sm:flex flex-col justify-start opacity-0 transition-opacity duration-300"
    >
      <div id="scrollbar-fill" class="w-full bg-accent rounded-full transition-[height] duration-75 ease-out h-0"></div>
    </div>

    <!-- Invert Aura Cursor -->
    <div id="cursor-dot" class="pointer-events-none fixed top-0 left-0 w-4 h-4 rounded-full bg-white z-[9999] mix-blend-difference hidden md:block opacity-0 transition-opacity duration-150"></div>
    <div id="cursor-aura" class="pointer-events-none fixed top-0 left-0 w-12 h-12 rounded-full border border-white/50 bg-white/10 blur-[0.5px] z-[9998] mix-blend-difference hidden md:block opacity-0 transition-opacity duration-150"></div>

    <!-- Back to Top & Contact Modal -->
    <BackToTop />
    <ContactModal client:load />

    <!-- Theme Switcher, Mobile Menu, Lenis, and Scroll-Reveal Observer -->
    <script>
      import Lenis from "lenis";

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (typeof window !== "undefined" && "scrollRestoration" in history) {
        history.scrollRestoration = "manual";
      }

      // Invert Aura Cursor (Global listeners attached once across transitions)
      if (typeof window !== "undefined" && !(window as any).__cursorInitialized) {
        (window as any).__cursorInitialized = true;

        let targetX = -100, targetY = -100;
        let auraX = -100, auraY = -100;
        let isMouseDown = false;
        let cursorActive = false;

        window.addEventListener("mousemove", (e: MouseEvent) => {
          if (!window.matchMedia("(pointer: fine)").matches) return;
          const dot = document.getElementById("cursor-dot");
          const aura = document.getElementById("cursor-aura");
          if (!dot || !aura) return;

          targetX = e.clientX;
          targetY = e.clientY;

          if (!cursorActive) {
            cursorActive = true;
            auraX = targetX;
            auraY = targetY;
          }

          if (dot.classList.contains("opacity-0")) dot.classList.remove("opacity-0");
          if (aura.classList.contains("opacity-0")) aura.classList.remove("opacity-0");

          dot.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) translate(-50%, -50%)`;
        }, { passive: true });

        function renderCursor() {
          const aura = document.getElementById("cursor-aura");
          if (cursorActive && aura) {
            auraX += (targetX - auraX) * 0.12;
            auraY += (targetY - auraY) * 0.12;
            const scale = isMouseDown ? 0.75 : 1;
            aura.style.transform = `translate3d(${auraX}px, ${auraY}px, 0) translate(-50%, -50%) scale(${scale})`;
          }
          requestAnimationFrame(renderCursor);
        }
        requestAnimationFrame(renderCursor);

        window.addEventListener("mousedown", () => {
          isMouseDown = true;
        });

        window.addEventListener("mouseup", () => {
          isMouseDown = false;
        });

        document.addEventListener("mouseleave", () => {
          cursorActive = false;
          const dot = document.getElementById("cursor-dot");
          const aura = document.getElementById("cursor-aura");
          if (dot) dot.classList.add("opacity-0");
          if (aura) aura.classList.add("opacity-0");
        });

        document.addEventListener("astro:page-load", () => {
          const dot = document.getElementById("cursor-dot");
          const aura = document.getElementById("cursor-aura");
          if ((cursorActive || window.matchMedia("(pointer: fine)").matches) && targetX >= 0) {
            cursorActive = true;
            if (dot) {
              dot.classList.remove("opacity-0");
              dot.style.transform = `translate3d(${targetX}px, ${targetY}px, 0) translate(-50%, -50%)`;
            }
            if (aura) {
              aura.classList.remove("opacity-0");
              aura.style.transform = `translate3d(${auraX}px, ${auraY}px, 0) translate(-50%, -50%)`;
            }
          }
        });
      }

      const getTargetScrollY = (el: HTMLElement): number => {
        const currentScroll = (window as any).lenis
          ? (window as any).lenis.actualScroll
          : (window.scrollY || window.pageYOffset || 0);
        const rect = el.getBoundingClientRect();
        // Lapses the section's top separator line 43px behind the 52px fixed header.
        // On 1920x932, SELECTED WORK (03) (pt-12 / 48px) lands at Y = 91px, Card 1 at Y = 200px,
        // Card 2 at Y = 429px, Card 3 at Y = 658px-863px, matching website.png perfectly.
        return Math.max(0, Math.round(rect.top + currentScroll - 43));
      };

      const closeMobileMenu = () => {
        const menuToggle = document.getElementById("mobile-menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuContent = document.getElementById("mobile-menu-content");
        const lineTop = document.getElementById("line-top");
        const lineMid = document.getElementById("line-mid");
        const lineBot = document.getElementById("line-bot");

        menuToggle?.setAttribute("aria-expanded", "false");
        mobileMenu?.classList.add("grid-rows-[0fr]", "opacity-0", "pointer-events-none", "border-border/0");
        mobileMenu?.classList.remove("grid-rows-[1fr]", "opacity-100", "pointer-events-auto", "border-border");
        menuContent?.classList.add("-translate-y-2");
        menuContent?.classList.remove("translate-y-0");
        lineTop?.style.removeProperty("transform");
        lineMid?.style.removeProperty("opacity");
        lineBot?.style.removeProperty("transform");
      };

      const scrollToTarget = (target: HTMLElement | string, immediate = false) => {
        const el = typeof target === "string" ? (document.querySelector(target) as HTMLElement | null) : target;
        if (!el) return;
        const targetY = getTargetScrollY(el);
        const isTouch = window.matchMedia("(pointer: coarse)").matches || "ontouchstart" in window;
        const activeLenis = (window as any).lenis;

        if (!isTouch && activeLenis && !prefersReducedMotion) {
          activeLenis.scrollTo(targetY, {
            duration: immediate ? 0 : 0.85,
            immediate,
          });
        } else {
          window.scrollTo({
            top: targetY,
            behavior: immediate || prefersReducedMotion ? "auto" : "smooth",
          });
        }
      };

      // Dynamic hash link interceptor: Intercept all links pointing to in-page hashes
      if (typeof window !== "undefined" && !(window as any).__hashNavInitialized) {
        (window as any).__hashNavInitialized = true;

        document.addEventListener("click", (e) => {
          const anchor = (e.target as HTMLElement)?.closest?.('a[href*="#"]') as HTMLAnchorElement | null;
          if (!anchor) return;
          const href = anchor.getAttribute("href");
          if (!href) return;

          try {
            const targetUrl = new URL(anchor.href, window.location.href);
            const isSamePage =
              targetUrl.pathname.replace(/\/$/, "") === window.location.pathname.replace(/\/$/, "");
            if (isSamePage && targetUrl.hash) {
              const targetEl = document.querySelector(targetUrl.hash) as HTMLElement | null;
              if (targetEl) {
                e.preventDefault();
                e.stopPropagation();

                closeMobileMenu();
                history.pushState(null, "", targetUrl.hash);

                const isTouch = window.matchMedia("(pointer: coarse)").matches || "ontouchstart" in window;
                if (isTouch) {
                  requestAnimationFrame(() => {
                    scrollToTarget(targetEl, false);
                  });
                } else {
                  scrollToTarget(targetEl, false);
                }
              }
            }
          } catch (err) {}
        });
      }

      let isWiping = false;
      const wipeSplashTransition = (onCovered?: () => void) => {
        if (isWiping) return;
        const splash = document.getElementById("splash-loader");
        const progress = document.getElementById("splash-progress");
        if (!splash || prefersReducedMotion) {
          onCovered?.();
          return;
        }
        isWiping = true;
        splash.style.transition = "none";
        splash.style.display = "flex";
        splash.style.transform = "translateY(100%)";
        splash.style.pointerEvents = "auto";
        if (progress) {
          progress.style.transition = "none";
          progress.style.width = "0%";
        }
        void splash.offsetHeight;

        splash.style.transition = "transform 0.42s cubic-bezier(0.76, 0, 0.24, 1)";
        splash.style.transform = "translateY(0%)";

        setTimeout(() => {
          onCovered?.();
          if (progress) {
            progress.style.transition = "width 0.28s ease-out";
            progress.style.width = "100%";
          }
          setTimeout(() => {
            splash.style.transition = "transform 0.45s cubic-bezier(0.76, 0, 0.24, 1)";
            splash.style.transform = "translateY(-100%)";
            splash.style.pointerEvents = "none";
            setTimeout(() => {
              splash.style.display = "none";
              splash.style.transform = "translateY(100%)";
              isWiping = false;
            }, 460);
          }, 280);
        }, 430);
      };

      const initPage = () => {
        // 1. Lenis Elastic Smooth Scrolling
        let lenis: any = null;
        if (!prefersReducedMotion) {
          if ((window as any).lenis) {
            try {
              (window as any).lenis.destroy();
            } catch (e) {}
          }

          lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            smoothWheel: true,
            wheelMultiplier: 1.0,
          });

          (window as any).lenis = lenis;

          if ((window as any).__lenisRafId) {
            cancelAnimationFrame((window as any).__lenisRafId);
          }
          function raf(time: number) {
            lenis.raf(time);
            (window as any).__lenisRafId = requestAnimationFrame(raf);
          }
          (window as any).__lenisRafId = requestAnimationFrame(raf);
        }

        // Handle initial hash on navigation or load (e.g. returning from a project)
        if (window.location.hash) {
          const hash = window.location.hash;
          const targetEl = document.querySelector(hash) as HTMLElement | null;
          if (targetEl) {
            scrollToTarget(targetEl, true);
            requestAnimationFrame(() => scrollToTarget(targetEl, true));
            setTimeout(() => scrollToTarget(targetEl, true), 60);
            setTimeout(() => scrollToTarget(targetEl, true), 160);
          }
        }

        // 2. Header "MARC" logo: navigate back to base URL with transition splash wipe
        const headerLogo = document.querySelector('#site-header a[href="/"]');
        if (headerLogo) {
          headerLogo.addEventListener("click", (e) => {
            const isHome = window.location.pathname === "/" || window.location.pathname === "" || window.location.pathname.endsWith("/index.html");
            if (window.location.hash || !isHome) {
              history.pushState(null, "", "/");
            }
            e.preventDefault();
            closeMobileMenu();

            wipeSplashTransition(() => {
              if (!isHome) {
                window.location.href = "/";
              } else {
                window.scrollTo(0, 0);
                const activeLenis = (window as any).lenis;
                if (activeLenis) activeLenis.scrollTo(0, { immediate: true });
              }
            });
          });
        }

        // 3. Custom Floating Long Pill Scrollbar
        const customScrollbar = document.getElementById("custom-scrollbar");
        const scrollbarFill = document.getElementById("scrollbar-fill");
        const updateCustomScrollbar = () => {
          if (!customScrollbar || !scrollbarFill) return;
          const scrollY = window.scrollY || window.pageYOffset || 0;
          const docHeight = document.documentElement.scrollHeight;
          const winHeight = window.innerHeight;
          const maxScroll = docHeight - winHeight;

          if (scrollY < 50 || maxScroll <= 0) {
            customScrollbar.classList.add("opacity-0");
          } else {
            customScrollbar.classList.remove("opacity-0");
            const progress = Math.min(Math.max((scrollY / maxScroll) * 100, 0), 100);
            scrollbarFill.style.height = `${progress}%`;
          }
        };
        window.addEventListener("scroll", updateCustomScrollbar, { passive: true });
        if (lenis) {
          lenis.on("scroll", updateCustomScrollbar);
        }
        window.addEventListener("resize", updateCustomScrollbar);
        updateCustomScrollbar();

        // 4. Dynamic Active Navigation Scroll Spy
        const sectionIds = ["projects", "skills", "contact"];
        const sections = sectionIds
          .map((id) => document.getElementById(id))
          .filter(Boolean) as HTMLElement[];
        const navLinks = document.querySelectorAll<HTMLAnchorElement>(
          'nav a[href*="#"], #mobile-menu a[href*="#"]'
        );

        if (sections.length > 0) {
          const spyObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const id = entry.target.getAttribute("id");
                  navLinks.forEach((link) => {
                    const href = link.getAttribute("href") || "";
                    if (href.endsWith(`#${id}`)) {
                      link.classList.add("text-accent", "font-bold");
                      link.classList.remove("text-text-muted");
                    } else {
                      link.classList.remove("text-accent", "font-bold");
                      link.classList.add("text-text-muted");
                    }
                  });
                }
              });
            },
            {
              rootMargin: "-20% 0px -60% 0px",
              threshold: 0,
            }
          );
          sections.forEach((section) => spyObserver.observe(section));
        }

        // 5. Dynamic Header Scroll Reveal
        const siteHeader = document.getElementById("site-header");
        const handleScrollHeader = () => {
          const scrollY = window.scrollY || window.pageYOffset || 0;
          const isHome = window.location.pathname === "/" || window.location.pathname === "";
          if (!isHome || scrollY > 120) {
            siteHeader?.classList.remove("opacity-0", "pointer-events-none", "-translate-y-2");
            siteHeader?.classList.add("opacity-100", "pointer-events-auto", "translate-y-0");
          } else {
            siteHeader?.classList.add("opacity-0", "pointer-events-none", "-translate-y-2");
            siteHeader?.classList.remove("opacity-100", "pointer-events-auto", "translate-y-0");
          }
        };
        window.addEventListener("scroll", handleScrollHeader, { passive: true });
        if (lenis) {
          lenis.on("scroll", () => handleScrollHeader());
        }
        handleScrollHeader();

        // 6. Theme Logic
        const getActiveThemePreference = (): string => {
          try {
            if (typeof sessionStorage !== "undefined") {
              const stored = sessionStorage.getItem("theme_preference");
              if (stored) return stored;
            }
          } catch (e) {}
          return "system";
        };

        const updateThemeToggleUI = () => {
          const pref = getActiveThemePreference();
          const iconEl = document.getElementById("theme-toggle-icon");
          const textEl = document.getElementById("theme-toggle-text");
          const iconMobileEl = document.getElementById("theme-toggle-mobile-icon");
          const iconHeroEl = document.getElementById("theme-toggle-hero-icon");
          const textHeroEl = document.getElementById("theme-toggle-hero-text");

          const iconMap: Record<string, string> = { system: "◐", light: "☼", dark: "☾" };
          const textMap: Record<string, string> = { system: "System", light: "Light", dark: "Dark" };

          if (iconEl) iconEl.textContent = iconMap[pref] || "◐";
          if (textEl) textEl.textContent = textMap[pref] || "System";
          if (iconMobileEl) iconMobileEl.textContent = iconMap[pref] || "◐";
          if (iconHeroEl) iconHeroEl.textContent = iconMap[pref] || "◐";
          if (textHeroEl) textHeroEl.textContent = textMap[pref] || "System";
        };

        const cycleTheme = () => {
          const currentPref = getActiveThemePreference();
          const cycle: Record<string, string> = { system: "light", light: "dark", dark: "system" };
          const next = cycle[currentPref] || "system";
          sessionStorage.setItem("theme_preference", next);
          document.documentElement.setAttribute("data-theme-preference", next);

          if (next === "system") {
            const resolved = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            document.documentElement.setAttribute("data-theme", resolved);
          } else {
            document.documentElement.setAttribute("data-theme", next);
          }
          updateThemeToggleUI();
        };

        document.getElementById("theme-toggle")?.addEventListener("click", cycleTheme);
        document.getElementById("theme-toggle-mobile")?.addEventListener("click", cycleTheme);
        document.getElementById("theme-toggle-hero")?.addEventListener("click", cycleTheme);
        updateThemeToggleUI();

        // 7. TLDR Mode Logic (Zero Layout Shift)
        const isTldrActive = (): boolean => {
          try {
            return localStorage.getItem("portfolio_tldr_active") === "true";
          } catch (e) {
            return false;
          }
        };

        const updateTldrUI = (active: boolean) => {
          if (active) {
            document.body.classList.add("tldr-active");
            document.documentElement.classList.add("tldr-active");
          } else {
            document.body.classList.remove("tldr-active");
            document.documentElement.classList.remove("tldr-active");
          }

          document.querySelectorAll("[data-tldr-toggle]").forEach((btn) => {
            btn.setAttribute("aria-pressed", active ? "true" : "false");
            const indicator = btn.querySelector(".tldr-indicator");
            const badge = btn.querySelector(".tldr-badge");

            if (active) {
              btn.classList.add("border-highlight", "text-text");
              btn.classList.remove("border-border", "border-accent", "text-accent");
              indicator?.classList.remove("bg-text-muted/60");
              indicator?.classList.add("bg-emerald-500");
              if (badge) {
                badge.textContent = "ON";
                badge.classList.add("bg-surface-raised", "text-text", "border-highlight");
                badge.classList.remove("bg-accent", "text-accent-text", "border-accent", "text-text-muted", "border-border-subtle");
              }
            } else {
              btn.classList.remove("border-highlight", "border-accent", "text-accent");
              btn.classList.add("border-border", "text-text");
              indicator?.classList.add("bg-text-muted/60");
              indicator?.classList.remove("bg-emerald-500");
              if (badge) {
                badge.textContent = "OFF";
                badge.classList.remove("border-highlight", "bg-accent", "text-accent-text", "border-accent");
                badge.classList.add("bg-surface-raised", "text-text-muted", "border-border-subtle");
              }
            }
          });
        };

        const toggleTldr = () => {
          const next = !isTldrActive();
          try {
            localStorage.setItem("portfolio_tldr_active", String(next));
          } catch (e) {}
          updateTldrUI(next);
        };

        document.querySelectorAll("[data-tldr-toggle]").forEach((btn) => {
          btn.addEventListener("click", toggleTldr);
        });
        updateTldrUI(isTldrActive());

        // 8. Mobile Menu Toggle with Smooth Animation
        const menuToggle = document.getElementById("mobile-menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuContent = document.getElementById("mobile-menu-content");
        const lineTop = document.getElementById("line-top");
        const lineMid = document.getElementById("line-mid");
        const lineBot = document.getElementById("line-bot");

        const setMobileMenuState = (isOpen: boolean) => {
          menuToggle?.setAttribute("aria-expanded", isOpen ? "true" : "false");
          if (isOpen) {
            mobileMenu?.classList.remove("grid-rows-[0fr]", "opacity-0", "pointer-events-none", "border-border/0");
            mobileMenu?.classList.add("grid-rows-[1fr]", "opacity-100", "pointer-events-auto", "border-border");
            menuContent?.classList.remove("-translate-y-2");
            menuContent?.classList.add("translate-y-0");
            lineTop?.style.setProperty("transform", "translateY(6px) rotate(45deg)");
            lineMid?.style.setProperty("opacity", "0");
            lineBot?.style.setProperty("transform", "translateY(-6px) rotate(-45deg)");
          } else {
            mobileMenu?.classList.add("grid-rows-[0fr]", "opacity-0", "pointer-events-none", "border-border/0");
            mobileMenu?.classList.remove("grid-rows-[1fr]", "opacity-100", "pointer-events-auto", "border-border");
            menuContent?.classList.add("-translate-y-2");
            menuContent?.classList.remove("translate-y-0");
            lineTop?.style.removeProperty("transform");
            lineMid?.style.removeProperty("opacity");
            lineBot?.style.removeProperty("transform");
          }
        };

        if (menuToggle && mobileMenu) {
          menuToggle.addEventListener("click", () => {
            const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
            setMobileMenuState(!isExpanded);
          });

          mobileMenu.querySelectorAll(".mobile-nav-link").forEach((link) => {
            link.addEventListener("click", () => {
              setMobileMenuState(false);
            });
          });

          document.addEventListener("keydown", (e) => {
            if (e.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") {
              setMobileMenuState(false);
            }
          });
        }

        // 8. Smooth Scroll Entrance Observer (GPU-composited micro-animations)
        if (!("IntersectionObserver" in window)) {
          document.querySelectorAll(".reveal-on-scroll").forEach((el) => el.classList.add("is-visible"));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            {
              threshold: 0.08,
              rootMargin: "0px 0px -30px 0px",
            }
          );

          document.querySelectorAll(".reveal-on-scroll").forEach((el) => observer.observe(el));
        }
      };

      document.addEventListener("astro:page-load", initPage);
    </script>
  </body>
</html>
