---
import "../styles/global.css";
import ContactModal from "../components/ContactModal";
import BackToTop from "../components/BackToTop.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marc | Full-Stack Software Engineer",
  description = "Full-stack engineer specializing in reliable production systems, database architecture, and replacing fragmented workflows.",
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site || "https://marcbalabat.tech",
);

const appVersion = import.meta.env.PUBLIC_APP_VERSION || "0.4.0";
const gitSha = import.meta.env.PUBLIC_GIT_SHA || "dev";
const gitBranch = import.meta.env.PUBLIC_GIT_BRANCH || "main";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Fonts: DM Sans (Human/Natural Sans) & Alumni Sans (Display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Alumni+Sans:ital,wght@0,700;0,800;0,900;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400..700&display=swap"
      rel="stylesheet"
    />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="twitter:card" content="summary_large_image" />

    <!-- Theme Initialization Script -->
    <script is:inline>
      const getStoredTheme = () => {
        try {
          if (typeof sessionStorage !== "undefined" && sessionStorage.getItem("theme_preference")) {
            return sessionStorage.getItem("theme_preference");
          }
        } catch (e) {}
        return "system";
      };

      const resolveTheme = (preference) => {
        if (preference === "system") {
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        return preference;
      };

      const pref = getStoredTheme();
      document.documentElement.setAttribute("data-theme", resolveTheme(pref));
      document.documentElement.setAttribute("data-theme-preference", pref);

      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
        if ((sessionStorage.getItem("theme_preference") || "system") === "system") {
          document.documentElement.setAttribute("data-theme", e.matches ? "dark" : "light");
        }
      });
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text antialiased selection:bg-accent selection:text-accent-text">
    <!-- Clean Minimalist Header (Sticky with backdrop blur) -->
    <header
      id="site-header"
      class="sticky top-0 left-0 right-0 z-40 bg-bg/90 backdrop-blur-md border-b border-border transition-colors"
    >
      <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
        <a href="/" class="group flex items-center gap-2 text-sm tracking-tight text-text shrink-0">
          <span class="inline-block w-2 h-2 rounded-full bg-accent group-hover:scale-125 transition-transform duration-200 shrink-0"></span>
          <span class="font-bold text-base tracking-tight">MARC</span>
          <span class="text-text-muted/60 hidden sm:inline">/</span>
          <span class="text-text-muted text-xs font-medium tracking-normal hidden sm:inline">SOFTWARE ENGINEER</span>
        </a>

        <!-- Desktop Navigation Items -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-semibold uppercase tracking-wider text-text-muted">
          <a href="/#projects" class="hover:text-text transition-colors">Projects</a>
          <a href="/#about" class="hover:text-text transition-colors">About</a>
          <a href="/#skills" class="hover:text-text transition-colors">Stack</a>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
            class="hover:text-text transition-colors cursor-pointer uppercase"
          >
            Contact
          </button>

          <!-- Theme Toggle (System -> Light -> Dark) -->
          <button
            id="theme-toggle"
            type="button"
            aria-label="Toggle color theme"
            title="Theme: System (default), Light, Dark"
            class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md hover:bg-surface-raised active:scale-[0.96] border border-border text-xs text-text transition-all cursor-pointer shrink-0 font-medium"
          >
            <span id="theme-toggle-icon" class="text-accent">◐</span>
            <span id="theme-toggle-text">System</span>
          </button>
        </nav>

        <!-- Mobile Controls -->
        <div class="flex md:hidden items-center gap-2 shrink-0">
          <button
            id="theme-toggle-mobile"
            type="button"
            aria-label="Toggle color theme"
            class="inline-flex items-center justify-center w-8 h-8 rounded-md hover:bg-surface-raised border border-border text-xs text-text cursor-pointer"
          >
            <span id="theme-toggle-mobile-icon">◐</span>
          </button>

          <button
            id="mobile-menu-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="mobile-menu"
            aria-label="Toggle navigation menu"
            class="inline-flex items-center justify-center w-8 h-8 rounded-md border border-border bg-surface text-text cursor-pointer"
          >
            <svg id="hamburger-icon" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="4" x2="20" y1="6" y2="6"></line>
              <line x1="4" x2="20" y1="12" y2="12"></line>
              <line x1="4" x2="20" y1="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-menu" class="hidden md:hidden w-full border-t border-border bg-bg/95 backdrop-blur-xl px-4 py-3">
        <div class="flex flex-col space-y-2 text-xs uppercase font-medium text-text max-w-5xl mx-auto">
          <a href="/#projects" class="mobile-nav-link py-2 hover:text-accent">Projects</a>
          <a href="/#about" class="mobile-nav-link py-2 hover:text-accent">About</a>
          <a href="/#skills" class="mobile-nav-link py-2 hover:text-accent">Stack</a>
          <button
            type="button"
            id="mobile-contact-btn"
            class="mobile-nav-link py-2 text-left uppercase hover:text-accent cursor-pointer"
          >
            Contact
          </button>
        </div>
      </div>
    </header>

    <!-- Main Container (Tightened max-w-5xl to reduce dead empty lateral margin) -->
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 flex flex-col min-h-screen">
      <main class="flex-1">
        <slot />
      </main>

      <!-- Minimalist Editorial Footer (Reduced top margin from mt-20 to mt-10) -->
      <footer class="py-8 border-t border-border mt-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-text-muted">
        <div class="flex flex-col gap-0.5">
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span class="text-text font-semibold uppercase tracking-wider text-[11px]">AVAILABLE FOR NEW OPPORTUNITIES</span>
          </div>
          <p>© {new Date().getFullYear()} Marc Balabat. v{appVersion} · {gitSha} ({gitBranch})</p>
        </div>

        <div class="flex flex-wrap items-center gap-x-5 gap-y-1.5 uppercase tracking-wider text-text font-medium text-[11px]">
          <a href="https://github.com/jsbalabat" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">GitHub</a>
          <a href="https://www.linkedin.com/in/marc-balabat" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">LinkedIn</a>
          <button
            type="button"
            onclick="window.dispatchEvent(new CustomEvent('open-contact-modal'))"
            class="hover:text-accent transition-colors cursor-pointer uppercase"
          >
            Email
          </button>
        </div>
      </footer>
    </div>

    <!-- Back to Top & Contact Modal -->
    <BackToTop />
    <ContactModal client:load />

    <!-- Theme Switcher, Mobile Menu, and Scroll-Reveal Observer -->
    <script>
      // 1. Theme Logic
      const getActiveThemePreference = (): string => {
        try {
          if (typeof sessionStorage !== "undefined") {
            const stored = sessionStorage.getItem("theme_preference");
            if (stored) return stored;
          }
        } catch (e) {}
        return "system";
      };

      const updateThemeToggleUI = () => {
        const pref = getActiveThemePreference();
        const iconEl = document.getElementById("theme-toggle-icon");
        const textEl = document.getElementById("theme-toggle-text");
        const iconMobileEl = document.getElementById("theme-toggle-mobile-icon");

        const iconMap: Record<string, string> = { system: "◐", light: "☼", dark: "☾" };
        const textMap: Record<string, string> = { system: "System", light: "Light", dark: "Dark" };

        if (iconEl) iconEl.textContent = iconMap[pref] || "◐";
        if (textEl) textEl.textContent = textMap[pref] || "System";
        if (iconMobileEl) iconMobileEl.textContent = iconMap[pref] || "◐";
      };

      const cycleTheme = () => {
        const currentPref = getActiveThemePreference();
        const cycle: Record<string, string> = { system: "light", light: "dark", dark: "system" };
        const next = cycle[currentPref] || "system";
        sessionStorage.setItem("theme_preference", next);
        document.documentElement.setAttribute("data-theme-preference", next);

        if (next === "system") {
          const resolved = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", resolved);
        } else {
          document.documentElement.setAttribute("data-theme", next);
        }
        updateThemeToggleUI();
      };

      document.getElementById("theme-toggle")?.addEventListener("click", cycleTheme);
      document.getElementById("theme-toggle-mobile")?.addEventListener("click", cycleTheme);
      updateThemeToggleUI();

      // 2. Mobile Menu Toggle
      const menuToggle = document.getElementById("mobile-menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      if (menuToggle && mobileMenu) {
        menuToggle.addEventListener("click", () => {
          mobileMenu.classList.toggle("hidden");
        });
        mobileMenu.querySelectorAll(".mobile-nav-link").forEach((link) => {
          link.addEventListener("click", () => mobileMenu.classList.add("hidden"));
        });
      }
      document.getElementById("mobile-contact-btn")?.addEventListener("click", () => {
        window.dispatchEvent(new CustomEvent("open-contact-modal"));
      });

      // 3. Smooth Scroll Entrance Observer (GPU-composited micro-animations)
      const initScrollReveals = () => {
        if (!("IntersectionObserver" in window)) {
          document.querySelectorAll(".reveal-on-scroll").forEach((el) => el.classList.add("is-visible"));
          return;
        }

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          {
            threshold: 0.08,
            rootMargin: "0px 0px -30px 0px",
          }
        );

        document.querySelectorAll(".reveal-on-scroll").forEach((el) => observer.observe(el));
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initScrollReveals);
      } else {
        initScrollReveals();
      }
    </script>
  </body>
</html>
