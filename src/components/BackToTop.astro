---
// src/components/BackToTop.astro
// Floating back-to-top button that fades in after scrolling
---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  title="Back to top"
  class="fixed bottom-6 right-6 sm:bottom-8 sm:right-8 lg:right-11 xl:right-14 z-40 flex items-center justify-center size-9 sm:size-10 rounded-full bg-surface-raised/95 backdrop-blur-sm border border-border text-text-muted hover:text-text shadow-sm hover:border-text hover:scale-110 active:scale-95 transition-all duration-200 cursor-pointer opacity-0 pointer-events-none translate-y-2 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent group"
>
  <svg
    viewBox="0 0 24 24"
    class="size-4 shrink-0 transition-transform duration-200 group-hover:-translate-y-1"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M18 15l-6-6-6 6"></path>
  </svg>
</button>

<script>
  let activeScrollHandler: (() => void) | null = null;

  const initBackToTop = () => {
    const backToTop = document.getElementById('back-to-top');
    if (!backToTop) return;

    if (activeScrollHandler) {
      window.removeEventListener('scroll', activeScrollHandler);
      const lenis = (window as any).lenis;
      if (lenis) lenis.off('scroll', activeScrollHandler);
      activeScrollHandler = null;
    }

    backToTop.addEventListener('click', () => {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lenis = (window as any).lenis;
      if (!prefersReducedMotion && lenis) {
        lenis.scrollTo(0, { duration: 1.2 });
      } else {
        window.scrollTo({
          top: 0,
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
        });
      }
    });

    const updateBackToTop = () => {
      const scrollY = window.scrollY || window.pageYOffset || 0;
      if (scrollY > 250) {
        backToTop.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
        backToTop.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      } else {
        backToTop.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
        backToTop.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      }
    };

    activeScrollHandler = updateBackToTop;
    window.addEventListener('scroll', updateBackToTop, { passive: true });
    const lenis = (window as any).lenis;
    if (lenis) {
      lenis.on('scroll', updateBackToTop);
    }
    updateBackToTop();
  };

  document.addEventListener('astro:page-load', initBackToTop);
  document.addEventListener('astro:before-swap', () => {
    if (activeScrollHandler) {
      window.removeEventListener('scroll', activeScrollHandler);
      const lenis = (window as any).lenis;
      if (lenis) lenis.off('scroll', activeScrollHandler);
      activeScrollHandler = null;
    }
  });
</script>
